// Refined Color Palette matching the design mockup
$primary-green: #19e64d;
$primary-green-dark: #00a859;
$bna-green: #00843D;
$bna-green-light: #10a049;
$bna-green-hover: #006e33;
$bg-neutral: #f6f8f6;
$card-bg: #ffffff;
$border-color: #e2e8f0;
$border-radius: 12px;
$shadow-soft: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
$shadow-hover: 0 4px 12px rgba(0, 0, 0, 0.1);
$text-primary: #1e293b;
$text-secondary: #64748b;
$text-muted: #94a3b8;
$slate-bg: #f8fafc;
$slate-border: #e2e8f0;

.dashboard-wrapper {
  height: 100%;
  display: flex;
  flex-direction: column;

  .content-area {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    background-color: $bg-neutral;

    .loading-container,
    .error-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 50vh;
      gap: 1rem;

      i {
        font-size: 3rem;
        color: #dc3545;
      }
    }

    .bento-dashboard {
      max-width: 1400px;
      margin: 0 auto;

      // Dashboard Header
      .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;

        .welcome-text {
          h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: $text-primary;
            margin: 0 0 0.25rem 0;
          }

          p {
            color: $text-secondary;
            margin: 0;
            font-size: 0.875rem;
          }
        }

        .status-badge {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          background-color: $slate-bg;
          border: 1px solid $slate-border;
          padding: 0.375rem 0.75rem;
          border-radius: 9999px;
          font-size: 0.75rem;
          color: $text-secondary;
          font-weight: 500;

          i {
            color: $primary-green;
            font-size: 0.5rem;
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
          }
        }
      }

      @keyframes pulse {
        0%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      // Bento Grid Layout
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        grid-auto-rows: minmax(120px, auto);

        // Grid Layout Structure
        .kpi-card {
          &:nth-child(1) { grid-column: 1 / 2; grid-row: 1 / 2; }
          &:nth-child(2) { grid-column: 2 / 3; grid-row: 1 / 2; }
          &:nth-child(3) { grid-column: 3 / 4; grid-row: 1 / 2; }
          &:nth-child(4) { grid-column: 4 / 5; grid-row: 1 / 2; }
        }

        .hero-card {
          grid-column: 1 / 3;
          grid-row: 2 / 5;
        }

        .risk-card {
          grid-column: 3 / 5;
          grid-row: 2 / 4;
        }

        .assignment-card {
          grid-column: 3 / 5;
          grid-row: 4 / 6;
        }

        .activity-card {
          grid-column: 1 / 3;
          grid-row: 5 / 7;
        }

        // KPI Cards
        .kpi-card {
          background: $card-bg;
          border: 1px solid $border-color;
          border-radius: $border-radius;
          padding: 1.25rem;
          box-shadow: $shadow-soft;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          min-height: 8rem;
          position: relative;
          transition: all 0.2s ease;

          &:hover {
            box-shadow: $shadow-hover;
            border-color: rgba($primary-green, 0.3);
          }

          &.pending {
            background: linear-gradient(135deg, #ffffff 0%, rgba($primary-green, 0.05) 100%);
            border-color: rgba($primary-green, 0.3);
            
            .kpi-label {
              color: $primary-green-dark;
              font-weight: 700;
            }
            
            .kpi-icon {
              background-color: rgba($primary-green, 0.1);
              color: $primary-green-dark;
            }
          }

          .kpi-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.5rem;
          }

          .kpi-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.5rem;
            background: $slate-bg;
            display: flex;
            align-items: center;
            justify-content: center;
            color: $text-secondary;
            font-size: 1.125rem;
            flex-shrink: 0;
            transition: all 0.2s ease;
            
            i {
              font-size: 1.125rem;
              font-weight: 400;
            }
          }

          &:hover .kpi-icon {
            background-color: rgba($primary-green, 0.1);
            color: $primary-green-dark;
          }
          
          &.pending .kpi-icon {
            background-color: rgba($primary-green, 0.15);
            color: $primary-green-dark;
          }

          .kpi-trend {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.25rem 0.5rem;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            line-height: 1;

            i {
              font-size: 0.625rem;
            }

            &.positive {
              background-color: #f0fdf4;
              color: #16a34a;
            }

            &.neutral {
              background-color: $slate-bg;
              color: $text-muted;
            }
          }

          .kpi-content {
            .kpi-label {
              font-size: 0.875rem;
              color: $text-secondary;
              font-weight: 500;
              margin-bottom: 0.5rem;
              line-height: 1.2;
            }

            .kpi-value {
              font-size: 1.875rem;
              font-weight: 700;
              color: $text-primary;
              line-height: 1;
            }
          }
        }

        // Hero Card - Pending Actions
        .hero-card {
          background: $card-bg;
          border: 1px solid $border-color;
          border-radius: $border-radius;
          padding: 0;
          box-shadow: $shadow-soft;
          display: flex;
          flex-direction: column;

          .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem;
            border-bottom: 1px solid $slate-border;

            h2 {
              font-size: 1.125rem;
              font-weight: 700;
              color: $text-primary;
              margin: 0;
            }

            .badge {
              padding: 0.25rem 0.5rem;
              border-radius: 0.25rem;
              font-size: 0.75rem;
              font-weight: 700;

              &.urgent-badge {
                background: rgba(#dc2626, 0.1);
                color: #dc2626;
              }
            }
          }

          .card-subtitle {
            color: $text-secondary;
            font-size: 0.875rem;
            padding: 0 1.5rem;
            padding-top: 0.5rem;
            margin: 0;
          }

          .action-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex: 1;
            padding: 1rem;

            .action-item {
              display: flex;
              align-items: center;
              gap: 1rem;
              padding: 0.75rem;
              background: $slate-bg;
              border: 1px solid $slate-border;
              border-radius: 0.5rem;
              transition: all 0.2s ease;

              &:hover {
                background: #ffffff;
                border-color: rgba($primary-green, 0.3);
              }

              .action-icon {
                width: 2rem;
                height: 2rem;
                border-radius: 0.5rem;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1rem;
                flex-shrink: 0;

                &.user {
                  background: #eff6ff;
                  color: #2563eb;
                }

                &.profile {
                  background: #faf5ff;
                  color: #9333ea;
                }

                &.approval {
                  background: #fff7ed;
                  color: #ea580c;
                }
              }

              .action-info {
                flex: 1;

                .action-count {
                  display: none;
                }

                .action-text {
                  font-size: 0.875rem;
                  font-weight: 600;
                  color: $text-primary;
                  margin-bottom: 0.125rem;
                }

                .action-detail {
                  font-size: 0.75rem;
                  color: $text-secondary;
                }
              }

              .action-btn {
                padding: 0.5rem 1rem;
                border-radius: 0.5rem;
                border: none;
                font-size: 0.875rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s ease;
                white-space: nowrap;

                i {
                  display: none;
                }

                &.primary {
                  background: $primary-green;
                  color: $text-primary;

                  &:hover {
                    background: darken($primary-green, 5%);
                  }
                }

                &.secondary {
                  background: white;
                  color: $text-primary;
                  border: 1px solid $border-color;

                  &:hover {
                    background: $slate-bg;
                  }
                }
              }
            }
          }

          .card-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid $slate-border;

            .view-all-link {
              color: $primary-green-dark;
              font-size: 0.875rem;
              font-weight: 600;
              text-decoration: none;
              display: inline-flex;
              align-items: center;
              gap: 0.25rem;
              transition: all 0.2s ease;

              &:hover {
                text-decoration: underline;
              }

              i {
                font-size: 0.75rem;
              }
            }
          }
        }

        // Risk & Compliance Card
        .risk-card {
          background: $card-bg;
          border: 1px solid $border-color;
          border-radius: $border-radius;
          padding: 0;
          box-shadow: $shadow-soft;
          display: flex;
          flex-direction: column;

          .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem;
            border-bottom: 1px solid $slate-border;

            h2 {
              font-size: 1.125rem;
              font-weight: 700;
              color: $text-primary;
              margin: 0;
              display: flex;
              align-items: center;
              gap: 0.5rem;

              i {
                color: #fb923c;
              }
            }

            .badge {
              background: #fff7ed;
              color: #ea580c;
              padding: 0.25rem 0.5rem;
              border-radius: 0.375rem;
              font-size: 0.75rem;
              font-weight: 600;
            }
          }

          .risk-items {
            padding: 1.5rem;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            flex: 1;

            .risk-item {
              padding: 1rem;
              border-radius: 0.75rem;
              border: 1px solid;
              display: flex;
              flex-direction: column;
              justify-content: center;
              position: relative;
              transition: all 0.2s ease;

              &.high {
                background: #fef2f2;
                border-color: #fecaca;

                .risk-count {
                  color: #dc2626;
                }

                .risk-title {
                  color: darken(#dc2626, 10%);
                }

                .risk-subtitle {
                  color: #dc2626;
                }

                .risk-icon {
                  color: rgba(#ef4444, 0.4);
                }
              }

              &.medium {
                background: #fff7ed;
                border-color: #fed7aa;

                .risk-count {
                  color: #ea580c;
                }

                .risk-title {
                  color: darken(#ea580c, 10%);
                }

                .risk-subtitle {
                  color: #ea580c;
                }

                .risk-icon {
                  color: rgba(#fb923c, 0.4);
                }
              }

              &.low {
                grid-column: span 2;
                background: $slate-bg;
                border-color: $slate-border;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;

                .risk-count {
                  display: none;
                }

                .risk-info {
                  flex: 1;

                  .risk-title {
                    color: $text-primary;
                    font-size: 0.875rem;
                    margin-bottom: 0.125rem;
                  }

                  .risk-subtitle {
                    color: $text-secondary;
                  }
                }

                .risk-icon {
                  color: $text-muted;
                  position: static;
                  font-size: 1.25rem;
                }
              }

              .risk-count {
                font-size: 1.5rem;
                font-weight: 700;
                margin-bottom: 0.5rem;
                line-height: 1;
              }

              .risk-icon {
                position: absolute;
                top: 1rem;
                right: 1rem;
                font-size: 1.25rem;
              }

              .risk-info {
                .risk-title {
                  font-size: 0.875rem;
                  font-weight: 600;
                  margin-bottom: 0.25rem;
                }

                .risk-subtitle {
                  font-size: 0.75rem;
                  margin-top: 0.25rem;
                }
              }
            }
          }
        }

        // Assignment Type Card
        .assignment-card {
          background: $card-bg;
          border: 1px solid $border-color;
          border-radius: $border-radius;
          padding: 0;
          box-shadow: $shadow-soft;
          display: flex;
          flex-direction: column;

          h3 {
            font-size: 1rem;
            font-weight: 700;
            color: $text-primary;
            margin: 0;
            padding: 1.5rem;
            border-bottom: 1px solid $slate-border;
          }

          .chart-container {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 1;
            min-height: 200px;
          }

          .chart-legend {
            padding: 0 1.5rem 1.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;

            .legend-item {
              display: flex;
              align-items: center;
              justify-content: space-between;
              font-size: 0.875rem;

              .legend-start {
                display: flex;
                align-items: center;
                gap: 0.5rem;
              }

              .legend-dot {
                width: 0.75rem;
                height: 0.75rem;
                border-radius: 9999px;
                flex-shrink: 0;

                &.pack {
                  background: $primary-green;
                }

                &.custom {
                  background: #cbd5e1;
                }
              }

              .legend-label {
                color: $text-secondary;
                font-weight: 500;
              }

              .legend-value {
                color: $text-primary;
                font-weight: 700;
                font-size: 0.875rem;
              }
            }
          }
        }

        // Activity Card
        .activity-card {
          background: $card-bg;
          border: 1px solid $border-color;
          border-radius: $border-radius;
          padding: 0;
          box-shadow: $shadow-soft;
          display: flex;
          flex-direction: column;
          overflow: hidden;

          .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem;
            border-bottom: 1px solid $slate-border;

            h2 {
              font-size: 1.125rem;
              font-weight: 700;
              color: $text-primary;
              margin: 0;
            }

            .filter-btn {
              background: none;
              border: none;
              color: $text-muted;
              cursor: pointer;
              padding: 0.25rem;
              transition: color 0.2s ease;

              &:hover {
                color: $text-secondary;
              }

              i {
                font-size: 1.25rem;
              }
            }
          }

          .activity-list {
            display: flex;
            flex-direction: column;
            flex: 1;

            .activity-item {
              display: grid;
              grid-template-columns: 2fr 1.5fr 2fr 1fr;
              align-items: center;
              padding: 1rem 1.5rem;
              border-bottom: 1px solid $slate-border;
              transition: background-color 0.2s ease;
              gap: 1rem;
              min-height: 60px;

              &:hover {
                background: $slate-bg;
              }

              &:last-child {
                border-bottom: none;
              }

              .activity-content {
                display: flex;
                align-items: center;
                gap: 0.75rem;
              }

              .activity-icon {
                width: 1.75rem;
                height: 1.75rem;
                border-radius: 0.375rem;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 0.875rem;

                &.success {
                  background: #f0fdf4;
                  color: #16a34a;
                }

                &.update {
                  background: #eff6ff;
                  color: #2563eb;
                }

                &.revoke {
                  background: #fef2f2;
                  color: #dc2626;
                }

                &.pack {
                  background: #faf5ff;
                  color: #9333ea;
                }

                &.deactivate {
                  background: $slate-bg;
                  color: $text-muted;
                }
              }

              .activity-action {
                font-size: 0.875rem;
                font-weight: 600;
                color: $text-primary;
              }

              .activity-actor,
              .activity-target {
                font-size: 0.875rem;
                color: $text-secondary;
              }

              .activity-time {
                font-size: 0.875rem;
                color: $text-muted;
                text-align: right;
              }

              .activity-details,
              .activity-separator {
                display: none;
              }
            }
          }
        }
      }

      // Responsive Design
      @media (max-width: 1200px) {
        .bento-grid {
          grid-template-columns: repeat(2, 1fr);

          .kpi-card {
            &:nth-child(1) { grid-column: 1 / 2; grid-row: 1 / 2; }
            &:nth-child(2) { grid-column: 2 / 3; grid-row: 1 / 2; }
            &:nth-child(3) { grid-column: 1 / 2; grid-row: 2 / 3; }
            &:nth-child(4) { grid-column: 2 / 3; grid-row: 2 / 3; }
          }

          .hero-card {
            grid-column: 1 / 3;
            grid-row: 3 / 6;
          }

          .risk-card {
            grid-column: 1 / 3;
            grid-row: 6 / 8;
          }

          .assignment-card {
            grid-column: 1 / 3;
            grid-row: 8 / 10;
          }

          .activity-card {
            grid-column: 1 / 3;
            grid-row: 10 / 12;
          }
        }
      }

      @media (max-width: 768px) {
        .bento-grid {
          grid-template-columns: 1fr;
          gap: 1rem;

          .kpi-card,
          .hero-card,
          .risk-card,
          .assignment-card,
          .activity-card {
            grid-column: 1 / 2;
            grid-row: auto;
          }

          .hero-card .action-item {
            flex-wrap: wrap;

            .action-btn {
              width: 100%;
              justify-content: center;
            }
          }

          .activity-card .activity-list .activity-item {
            grid-template-columns: 1fr;
            gap: 0.5rem;

            .activity-time {
              text-align: left;
            }
          }

          .risk-card .risk-items {
            grid-template-columns: 1fr;

            .risk-item.low {
              grid-column: span 1;
            }
          }
        }
      }
    }
  }
}
