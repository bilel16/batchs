	<parameter name="P_DATE_JOURNEE" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select (SUM(MNT_30)over(partition BY 1)) /1000 AS SOMTOT_30,
(SUM(MNT_31)over(partition BY 1)) /1000 AS SOMTOT_31,
(SUM(MNT_32)over(partition BY 1)) /1000 AS SOMTOT_32,
(SUM(MNT_33)over(partition BY 1)) /1000 AS SOMTOT_33,
(SUM(NBRE_30)over(partition BY 1)) AS NBRETOT_30,
(SUM(NBRE_31)over(partition BY 1)) AS NBRETOT_31,
(SUM(NBRE_32)over(partition BY 1)) AS NBRETOT_32,
(SUM(NBRE_33)over(partition BY 1)) AS NBRETOT_33,
COD_AG ,DAT_OP ,(MNT_30/1000) as MNT_30,NBRE_30,
(MNT_31/1000) as MNT_31 ,NBRE_31,(MNT_32/1000) as MNT_32 ,
NBRE_32,(MNT_33/1000) as MNT_33 ,NBRE_33,(MNT_20/1000) as MNT_20 ,
NBRE_20,NBRE_80 from recap_envoi
 where  to_char(dat_op,'DD/MM/YYYY')=$P{P_DATE_JOURNEE}
 and cod_ag not between 703 and 900  order by cod_ag asc]]></queryString>

