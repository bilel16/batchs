	<parameter name="P_DATE_JOURNEE" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select (SUM(NBRE_20)over(partition BY 1)) AS NBRETOT_20,
(SUM(NBRE_80)over(partition BY 1)) AS NBRETOT_80,
(SUM(MNT_20)over(partition BY 1))/1000 AS MNTTOT_20,
COD_AG,(MNT_20/1000) as MNT_20 ,NBRE_20,NBRE_80 from recap_envoi  where  to_char(dat_op,'DD/MM/YYYY')=$P{P_DATE_JOURNEE}  
and cod_ag not between 703 and 900 order by cod_ag asc]]></queryString>

	<field name="COD_AG" class="java.lang.String"/>
	<field name="MNT_20" class="java.math.BigDecimal"/>
	<field name="NBRE_20" class="java.math.BigDecimal"/>
	<field name="NBRE_80" class="java.math.BigDecimal"/>
