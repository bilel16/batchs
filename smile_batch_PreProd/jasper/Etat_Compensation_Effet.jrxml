	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="P_DATE_JOURNEE" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select (SUM(MNT_4021)over(partition BY 1)) /1000 AS som4021,
(SUM(MNT_4025)over(partition BY 1)) /1000 AS som4025,
(SUM(MNT_4121)over(partition BY 1)) /1000 AS som4121,
(SUM(MNT_4125)over(partition BY 1)) /1000 AS som4125,
(SUM(NBRE_4021)over(partition BY 1)) AS NBRETOT_4021,
(SUM(NBRE_4025)over(partition BY 1)) AS NBRETOT_4025,
(SUM(NBRE_4121)over(partition BY 1)) AS NBRETOT_4121,
(SUM(NBRE_4125)over(partition BY 1)) AS NBRETOT_4125,
COD_AG ,DAT_OP ,(MNT_4021/1000) as MNT_4021,NBRE_4021,
(MNT_4025/1000) as MNT_4025 ,NBRE_4025,(MNT_4121/1000) as MNT_4121 ,
NBRE_4121,(MNT_4125/1000) as MNT_4125 ,NBRE_4125
from recap_envoi
 where  to_char(dat_op,'DD/MM/YYYY')=$P{P_DATE_JOURNEE}

  and cod_ag  in (select cod_strc_strc from structure  where cod_tstr_tstr=1)
 order by cod_ag asc]]></queryString>

