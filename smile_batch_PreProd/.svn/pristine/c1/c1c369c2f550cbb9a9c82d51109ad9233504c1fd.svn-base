package com.bna.smile.model.domainecommun.model;

import com.oxia.fwk.core.ValueObject;

public class ContratCheque  extends ValueObject{

    private IdContratCpt idContratCpt;
    private String  numCheque;
    
    public ContratCheque() {
    }

    public void setIdContratCpt(IdContratCpt idContratCpt) {
        this.idContratCpt = idContratCpt;
    }

    public IdContratCpt getIdContratCpt() {
        return idContratCpt;
    }

    public void setNumCheque(String numCheque) {
        this.numCheque = numCheque;
    }

    public String getNumCheque() {
        return numCheque;
    }
}
