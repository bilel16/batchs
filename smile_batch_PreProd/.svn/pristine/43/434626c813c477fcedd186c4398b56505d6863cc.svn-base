package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;


import com.bna.smile.model.domainecommun.model.PersonneStrc;
import com.oxia.fwk.core.ValueObject;

public class PersonneTypeCarteCpt   extends ValueObject {

    private PersonneStrc personneStrc; 
    private TypeCarteCpt typeCarteCpt;

    public PersonneTypeCarteCpt () {
    }


    public void setPersonneStrc(PersonneStrc personneStrc) {
        this.personneStrc = personneStrc;
    }

    public PersonneStrc getPersonneStrc() {
        return personneStrc;
    }

    public void setTypeCarteCpt(TypeCarteCpt typeCarteCpt) {
        this.typeCarteCpt = typeCarteCpt;
    }

    public TypeCarteCpt getTypeCarteCpt() {
        return typeCarteCpt;
    }
}
