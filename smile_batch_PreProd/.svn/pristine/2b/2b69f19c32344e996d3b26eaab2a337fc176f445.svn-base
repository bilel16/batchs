package com.bna.smile.web.reporting.forms;

import com.bna.smile.web.commun.view.InitialisationView;

import com.bna.smile.web.reporting.View.ExtraitView;

import java.util.ArrayList;

import org.apache.struts.action.ActionForm;
import java.util.Collection;

public class ExtraitCptForm extends ActionForm  {

    private InitialisationView initialisationView = new InitialisationView();
    private String codStrcStrc;
    private String codPrdPrd;
    private String numCcptCcpt;
    private String nomPrnPers;
    private String rib;
    private String cle;
    private String montantBloque;
    private String faciliteCaisse;
    private String soldeCompte;
    private String echeance;
    private String devise;
    private String dateDeb;
    private String dateFin;
    private Collection listeOperationMoyPay =new ArrayList();
    private boolean personneExist = true;
    private boolean verifDatCompt = true;
    private ExtraitView extraitView = new ExtraitView();
    private String numOperationChoisi;
    private String cleNumOperChoisi;
   
    public void clearForm(){
            this.codStrcStrc="";
            this.codPrdPrd="";
            this.numCcptCcpt="";
            this.nomPrnPers="";
            this.rib="";
            this.cle="";
            this.montantBloque="";
            this.faciliteCaisse="";
            this.dateDeb="";
            this.dateFin="";
            this.devise="";
            this.echeance="";
            this.soldeCompte="";
            personneExist = true;
            verifDatCompt = true;
            listeOperationMoyPay =new ArrayList();
            this.numOperationChoisi="";
            this.cleNumOperChoisi="";
        }
    public void setInitialisationView(InitialisationView initialisationView) {
        this.initialisationView = initialisationView;
    }

    public InitialisationView getInitialisationView() {
        return initialisationView;
    }

    public void setCodStrcStrc(String codStrcStrc) {
        this.codStrcStrc = codStrcStrc;
    }

    public String getCodStrcStrc() {
        return codStrcStrc;
    }

    public void setCodPrdPrd(String codPrdPrd) {
        this.codPrdPrd = codPrdPrd;
    }

    public String getCodPrdPrd() {
        return codPrdPrd;
    }

    public void setNumCcptCcpt(String numCcptCcpt) {
        this.numCcptCcpt = numCcptCcpt;
    }

    public String getNumCcptCcpt() {
        return numCcptCcpt;
    }

    public void setNomPrnPers(String nomPrnPers) {
        this.nomPrnPers = nomPrnPers;
    }

    public String getNomPrnPers() {
        return nomPrnPers;
    }

    public void setRib(String rib) {
        this.rib = rib;
    }

    public String getRib() {
        return rib;
    }

    public void setCle(String cle) {
        this.cle = cle;
    }

    public String getCle() {
        return cle;
    }

    public void setDateDeb(String dateDeb) {
        this.dateDeb = dateDeb;
    }

    public String getDateDeb() {
        return dateDeb;
    }

    public void setDateFin(String dateFin) {
        this.dateFin = dateFin;
    }

    public String getDateFin() {
        return dateFin;
    }

    public void setMontantBloque(String montantBloque) {
        this.montantBloque = montantBloque;
    }

    public String getMontantBloque() {
        return montantBloque;
    }

    public void setFaciliteCaisse(String faciliteCaisse) {
        this.faciliteCaisse = faciliteCaisse;
    }

    public String getFaciliteCaisse() {
        return faciliteCaisse;
    }

    public void setPersonneExist(boolean personneExist) {
        this.personneExist = personneExist;
    }

    public boolean isPersonneExist() {
        return personneExist;
    }

    public void setListeOperationMoyPay(Collection listeOperationMoyPay) {
        this.listeOperationMoyPay = listeOperationMoyPay;
    }

    public Collection getListeOperationMoyPay() {
        return listeOperationMoyPay;
    }

    public void setSoldeCompte(String soldeCompte) {
        this.soldeCompte = soldeCompte;
    }

    public String getSoldeCompte() {
        return soldeCompte;
    }

    public void setEcheance(String echeance) {
        this.echeance = echeance;
    }

    public String getEcheance() {
        return echeance;
    }

    public void setDevise(String devise) {
        this.devise = devise;
    }

    public String getDevise() {
        return devise;
    }

    public void setVerifDatCompt(boolean verifDatCompt) {
        this.verifDatCompt = verifDatCompt;
    }

    public boolean isVerifDatCompt() {
        return verifDatCompt;
    }

    public void setExtraitView(ExtraitView extraitView) {
        this.extraitView = extraitView;
    }

    public ExtraitView getExtraitView() {
        return extraitView;
    }

    public void setNumOperationChoisi(String numOperationChoisi) {
        this.numOperationChoisi = numOperationChoisi;
    }

    public String getNumOperationChoisi() {
        return numOperationChoisi;
    }

    public void setCleNumOperChoisi(String cleNumOperChoisi) {
        this.cleNumOperChoisi = cleNumOperChoisi;
    }

    public String getCleNumOperChoisi() {
        return cleNumOperChoisi;
    }
}
