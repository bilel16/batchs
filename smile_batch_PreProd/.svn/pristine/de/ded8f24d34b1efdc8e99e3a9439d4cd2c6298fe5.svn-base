public class InteretServiView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {

    private String numIsrvIsrv;
    private String datIsrvIsrv;
    private String datValIsrv;
    private String montIsrvIsrv;
    private String montIrcIsrv;
    private String montBrutIrc;
