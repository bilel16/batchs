package com.bna.smile.model.domainecontratcompte.souscriptioncontratcompte.model;

import com.oxia.fwk.core.ValueObject;

/** Fichier: TypeCatPers.java version 1.0.0 du 07/03/2007
 * Copyright(c) 2007 BNA (www.bna.com.tn)
 * Classe: ParamEpargne
 * package: com.bna.smile.model.domainecontratcompte.souscriptioncontratcompte.model
 * Auteur : Hassine
 */
public class ParamEpargne extends ValueObject {

    private Long codPrdPrd;
    private String codRgmRgm;
    private String codCatCat;
    private String codCorrCat;


    public ParamEpargne() {
    }

    public ParamEpargne(Long codPrdPrd, String codRgmRgm, String codCatCat) {
        this.codPrdPrd = codPrdPrd;
        this.codRgmRgm = codRgmRgm;
        this.codCatCat = codCatCat;

    }

    public void setCodPrdPrd(Long codPrdPrd) {
        this.codPrdPrd = codPrdPrd;
    }

    public Long getCodPrdPrd() {
        return codPrdPrd;
    }


    public void setCodCatCat(String codCatCat) {
        this.codCatCat = codCatCat;
    }

    public String getCodCatCat() {
        return codCatCat;
    }

    public void setCodRgmRgm(String codRgmRgm) {
        this.codRgmRgm = codRgmRgm;
    }

    public String getCodRgmRgm() {
        return codRgmRgm;
    }

    public void setCodCorrCat(String codCorrCat) {
        this.codCorrCat = codCorrCat;
    }

    public String getCodCorrCat() {
        return codCorrCat;
    }
}
