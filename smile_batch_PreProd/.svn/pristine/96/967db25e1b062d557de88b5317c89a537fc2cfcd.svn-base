package com.bna.smile.model.telex.model;

public class Structure {

	private Integer COD_STRC_STRC;
	private String LIB_STRC_STRC;
	private String LIB_MAIL_STRC;
	
	public Integer getCOD_STRC_STRC() {
		return COD_STRC_STRC;
	}
	public void setCOD_STRC_STRC(Integer cOD_STRC_STRC) {
		COD_STRC_STRC = cOD_STRC_STRC;
	}
	public String getLIB_STRC_STRC() {
		return LIB_STRC_STRC;
	}
	public void setLIB_STRC_STRC(String lIB_STRC_STRC) {
		LIB_STRC_STRC = lIB_STRC_STRC;
	}
	public String getLIB_MAIL_STRC() {
		return LIB_MAIL_STRC;
	}
	public void setLIB_MAIL_STRC(String lIB_MAIL_STRC) {
		LIB_MAIL_STRC = lIB_MAIL_STRC;
	}
	
	
	
}
