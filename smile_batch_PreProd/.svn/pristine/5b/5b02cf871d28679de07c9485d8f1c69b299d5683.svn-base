package com.bna.smile.model.domainecommun.model;

import com.bna.commun.model.ExonerationCltTva;
import com.bna.commun.model.TraceExoTva;

import com.oxia.fwk.core.ValueObject;

public class ParamExonerationCltTva extends ValueObject{

    private ExonerationCltTva exonerationCltTva;
    private TraceExoTva traceExoTva;
    private String codeOperation;
    private String codeTache;
    
    public ParamExonerationCltTva() {
    }

    public void setExonerationCltTva(ExonerationCltTva exonerationCltTva) {
        this.exonerationCltTva = exonerationCltTva;
    }

    public ExonerationCltTva getExonerationCltTva() {
        return exonerationCltTva;
    }

    public void setTraceExoTva(TraceExoTva traceExoTva) {
        this.traceExoTva = traceExoTva;
    }

    public TraceExoTva getTraceExoTva() {
        return traceExoTva;
    }

    public void setCodeOperation(String codeOperation) {
        this.codeOperation = codeOperation;
    }

    public String getCodeOperation() {
        return codeOperation;
    }

    public void setCodeTache(String codeTache) {
        this.codeTache = codeTache;
    }

    public String getCodeTache() {
        return codeTache;
    }
}
