			<artifactId>httpclient</artifactId>
			 <version>4.5</version>
		</dependency>
		
		
		<dependency>
			<groupId>com.microsoft.ewsjavaapi</groupId>
			<artifactId>exchange-ws-api</artifactId>
			<version>1.1.5.2</version>
		</dependency>
		
	</dependencies>

</project>
