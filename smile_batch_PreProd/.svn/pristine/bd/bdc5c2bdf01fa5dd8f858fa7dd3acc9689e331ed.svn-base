package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;




import java.util.List;

import com.bna.commun.model.DemandeCarte;
import com.oxia.fwk.core.ValueObject;

public class DemandeCarteSignataire  extends ValueObject {

    private DemandeCarte demandeCarte; 
    private List signataire; //list de demandeCarteMandatPersonne

    public DemandeCarteSignataire() {
    }


    public void setDemandeCarte(DemandeCarte demandeCarte) {
        this.demandeCarte = demandeCarte;
    }

    public DemandeCarte getDemandeCarte() {
        return demandeCarte;
    }

    public void setSignataire(List signataire) {
        this.signataire = signataire;
    }

    public List getSignataire() {
        return signataire;
    }
}
