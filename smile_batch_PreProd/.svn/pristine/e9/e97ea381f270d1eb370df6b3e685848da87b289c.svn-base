public class PariteOfficielleView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {

    private String annee;
    private String codedevise;
    private String montCoursPaof;
    private String libDevise;
     
      
    public PariteOfficielleView() {      
    }  

    public void setCodedevise(String codedevise) {
        this.codedevise = codedevise;
    }

    public String getCodedevise() {
        return codedevise;
    }

    public void setMontCoursPaof(String montCoursPaof) {
        this.montCoursPaof = montCoursPaof;
    }

    public String getMontCoursPaof() {
        return montCoursPaof;
    }

    public void setAnnee(String annee) {
        this.annee = annee;
    }

    public String getAnnee() {
        return annee;
    }

    public void setLibDevise(String libDevise) {
        this.libDevise = libDevise;
    }

    public String getLibDevise() {
        return libDevise;
    }
}
