package com.bna.smile.model.clotureDomaine.model;

public class StatAvancesVo {
    public StatAvancesVo() {
    }
    
    private Long cod_prd_plc;
    private String lib_prd_plc;
    private Long nbr_Avanc_att;
    private String mnt_Avanc_att;
    private Long nbr_Avanc_Val;
    private String mnt_Avanc_Val;
    private Long nbr_Avanc_Rej;
    private String mnt_Avanc_Rej;
    private Long nbr_Avanc_Remb;
    private String mnt_Avanc_Remb;

    public void setCod_prd_plc(Long cod_prd_plc) {
        this.cod_prd_plc = cod_prd_plc;
    }

    public Long getCod_prd_plc() {
        return cod_prd_plc;
    }

    public void setLib_prd_plc(String lib_prd_plc) {
        this.lib_prd_plc = lib_prd_plc;
    }

    public String getLib_prd_plc() {
        return lib_prd_plc;
    }

    public void setNbr_Avanc_att(Long nbr_Avanc_att) {
        this.nbr_Avanc_att = nbr_Avanc_att;
    }

    public Long getNbr_Avanc_att() {
        return nbr_Avanc_att;
    }

    public void setMnt_Avanc_att(String mnt_Avanc_att) {
        this.mnt_Avanc_att = mnt_Avanc_att;
    }

    public String getMnt_Avanc_att() {
        return mnt_Avanc_att;
    }

    public void setNbr_Avanc_Val(Long nbr_Avanc_Val) {
        this.nbr_Avanc_Val = nbr_Avanc_Val;
    }

    public Long getNbr_Avanc_Val() {
        return nbr_Avanc_Val;
    }

    public void setMnt_Avanc_Val(String mnt_Avanc_Val) {
        this.mnt_Avanc_Val = mnt_Avanc_Val;
    }

    public String getMnt_Avanc_Val() {
        return mnt_Avanc_Val;
    }

    public void setNbr_Avanc_Rej(Long nbr_Avanc_Rej) {
        this.nbr_Avanc_Rej = nbr_Avanc_Rej;
    }

    public Long getNbr_Avanc_Rej() {
        return nbr_Avanc_Rej;
    }

    public void setMnt_Avanc_Rej(String mnt_Avanc_Rej) {
        this.mnt_Avanc_Rej = mnt_Avanc_Rej;
    }

    public String getMnt_Avanc_Rej() {
        return mnt_Avanc_Rej;
    }

    public void setNbr_Avanc_Remb(Long nbr_Avanc_Remb) {
        this.nbr_Avanc_Remb = nbr_Avanc_Remb;
    }

    public Long getNbr_Avanc_Remb() {
        return nbr_Avanc_Remb;
    }

    public void setMnt_Avanc_Remb(String mnt_Avanc_Remb) {
        this.mnt_Avanc_Remb = mnt_Avanc_Remb;
    }

    public String getMnt_Avanc_Remb() {
        return mnt_Avanc_Remb;
    }
}
