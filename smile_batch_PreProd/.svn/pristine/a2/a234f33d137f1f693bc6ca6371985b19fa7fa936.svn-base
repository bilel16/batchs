
package com.bna.smile.model.domainecontratcompte.souscriptioncontratcompte.model;


import com.bna.commun.model.ContratCpt;
import com.bna.commun.model.Personnel;
import com.oxia.fwk.core.ValueObject;

/** Fichier: ParamCompteLie.java version 1.0.0 du 30/04/2007
 * Copyright(c) 2007 BNA (www.bna.com.tn)
 * Classe: ParamCompteLie
 * package: com.bna.smile.model.domainecontratcompte.souscriptioncontratcompte.model
 * Auteur : El arbi hassine && Mdimagh Lassad
 */
public class ParamCompteLie extends ValueObject {

    ContratCpt contratCpt = new ContratCpt();
    Long codeProduit;
    Long montantSoldeMinimum;
    Integer NbreContrats = new Integer(0);
    Personnel personnel = new Personnel();

    public ParamCompteLie() {
    }


    public void setContratCpt(ContratCpt contratCpt) {
        this.contratCpt = contratCpt;
    }

    public ContratCpt getContratCpt() {
        return contratCpt;
    }


    public void setCodeProduit(Long codeProduit) {
        this.codeProduit = codeProduit;
    }

    public Long getCodeProduit() {
        return codeProduit;
    }


    public void setNbreContrats(Integer nbreContrats) {
        this.NbreContrats = nbreContrats;
    }

    public Integer getNbreContrats() {
        return NbreContrats;
    }

    public void setMontantSoldeMinimum(Long montantSoldeMinimum) {
        this.montantSoldeMinimum = montantSoldeMinimum;
    }

    public Long getMontantSoldeMinimum() {
        return montantSoldeMinimum;
    }

    public void setPersonnel(Personnel personnel) {
        this.personnel = personnel;
    }

    public Personnel getPersonnel() {
        return personnel;
    }
}
