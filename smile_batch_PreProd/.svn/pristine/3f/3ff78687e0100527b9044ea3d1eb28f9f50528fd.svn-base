package com.bna.smile.web.operationguichet.view;

import com.bna.commun.model.SessionJrnCaisse;

public class MouvementSessionCaisseView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {

    private String caisOriginView;
    private String numMouvement;
    private String montantMvtView;
    private String devMvt;
    private String caisReceptMvt;
    private String typCaisReceptMvt;
    private String natCaisReceptMvt;
    private String natMonnaieMvt;
    private String codeStructure;

    public MouvementSessionCaisseView() {
    }

    public void setCaisOriginView(String caisOriginView) {
        this.caisOriginView = caisOriginView;
    }

    public String getCaisOriginView() {
        return caisOriginView;
    }

    public void setMontantMvtView(String montantMvtView) {
        this.montantMvtView = montantMvtView;
    }

    public String getMontantMvtView() {
        return montantMvtView;
    }

    public void setDevMvt(String devMvt) {
        this.devMvt = devMvt;
    }

    public String getDevMvt() {
        return devMvt;
    }

    public void setCaisReceptMvt(String caisReceptMvt) {
        this.caisReceptMvt = caisReceptMvt;
    }

    public String getCaisReceptMvt() {
        return caisReceptMvt;
    }

    public void setTypCaisReceptMvt(String typCaisReceptMvt) {
        this.typCaisReceptMvt = typCaisReceptMvt;
    }

    public String getTypCaisReceptMvt() {
        return typCaisReceptMvt;
    }

    public void setNatCaisReceptMvt(String natCaisReceptMvt) {
        this.natCaisReceptMvt = natCaisReceptMvt;
    }

    public String getNatCaisReceptMvt() {
        return natCaisReceptMvt;
    }

    public void setNumMouvement(String numMouvement) {
        this.numMouvement = numMouvement;
    }

    public String getNumMouvement() {
        return numMouvement;
    }

    public void setNatMonnaieMvt(String natMonnaieMvt) {
        this.natMonnaieMvt = natMonnaieMvt;
    }

    public String getNatMonnaieMvt() {
        return natMonnaieMvt;
    }


    public void setCodeStructure(String codeStructure) {
        this.codeStructure = codeStructure;
    }

    public String getCodeStructure() {
        return codeStructure;
    }

}
