package com.bna.smile.model.domainecommun.model;

import java.io.Serializable;

public class AFBMvt implements Serializable {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private String NUM_COMPTE;
	private String DATE_OPERATION;
	private String CODE_OPERATION;
	private String CODE_SE;
	private String CODE_TERME;
	private String MVTS_DEBITEURS;
	private String MVTS_CREDITEURS;
	private String DATE_VALEUR;
	private String REFERENCE;
	private String LIBELLE;
	private String LIB;
	
	// ******Getter && Setter ***********//
	
	
	public String getNUM_COMPTE() {
		return NUM_COMPTE;
	}
	
	public void setNUM_COMPTE(String nUM_COMPTE) {
		NUM_COMPTE = nUM_COMPTE;
	}
	
	public String getDATE_OPERATION() {
		return DATE_OPERATION;
	}
	
	public void setDATE_OPERATION(String dATE_OPERATION) {
		DATE_OPERATION = dATE_OPERATION;
	}
	
	public String getCODE_OPERATION() {
		return CODE_OPERATION;
	}
	
	public void setCODE_OPERATION(String cODE_OPERATION) {
		CODE_OPERATION = cODE_OPERATION;
	}
	
	public String getCODE_SE() {
		return CODE_SE;
	}
	
	public void setCODE_SE(String cODE_SE) {
		CODE_SE = cODE_SE;
	}
	
	public String getCODE_TERME() {
		return CODE_TERME;
	}
	
	public void setCODE_TERME(String cODE_TERME) {
		CODE_TERME = cODE_TERME;
	}
	
	public String getMVTS_DEBITEURS() {
		return MVTS_DEBITEURS;
	}
	
	public void setMVTS_DEBITEURS(String mVTS_DEBITEURS) {
		MVTS_DEBITEURS = mVTS_DEBITEURS;
	}
	
	public String getMVTS_CREDITEURS() {
		return MVTS_CREDITEURS;
	}
	
	public void setMVTS_CREDITEURS(String mVTS_CREDITEURS) {
		MVTS_CREDITEURS = mVTS_CREDITEURS;
	}
	
	public String getDATE_VALEUR() {
		return DATE_VALEUR;
	}
	
	public void setDATE_VALEUR(String dATE_VALEUR) {
		DATE_VALEUR = dATE_VALEUR;
	}
	
	public String getREFERENCE() {
		return REFERENCE;
	}
	
	public void setREFERENCE(String rEFERENCE) {
		REFERENCE = rEFERENCE;
	}
	
	public String getLIBELLE() {
		return LIBELLE;
	}
	
	public void setLIBELLE(String lIBELLE) {
		LIBELLE = lIBELLE;
	}
	
	public String getLIB() {
		return LIB;
	}
	
	public void setLIB(String lIB) {
		LIB = lIB;
	}

	

	

}
