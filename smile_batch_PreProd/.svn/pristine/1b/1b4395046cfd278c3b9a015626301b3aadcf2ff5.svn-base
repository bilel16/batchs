public class

ListTypeCatTpce extends ValueObject {

    private List listTypePers = new ArrayList();
    private List listCatPers = new ArrayList();
    private List listeCategp_Formj = new ArrayList();
    private TypePiece typePiece;

    public ListTypeCatTpce() {
    }

    public void setListTypePers(List listTypePers) {
        this.listTypePers = listTypePers;
    }

    public List getListTypePers() {
        return listTypePers;
    }

    public void setListCatPers(List listCatPers) {
        this.listCatPers = listCatPers;
    }

    public List getListCatPers() {
        return listCatPers;
    }

    public void setListeCategp_Formj(List listeCategp_Formj) {
        this.listeCategp_Formj = listeCategp_Formj;
    }

    public List getListeCategp_Formj() {
        return listeCategp_Formj;
    }

    public void setTypePiece(TypePiece typePiece) {
        this.typePiece = typePiece;
    }

    public TypePiece getTypePiece() {
        return typePiece;
    }
}
