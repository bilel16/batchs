package com.bna.smile.model.clotureDomaine.model;

public class CloturePlacVo {
    public CloturePlacVo() {
    }
    private Long codOpertation;
    private Long nombre;
    private Double Montant;

    public void setCodOpertation(Long codOpertation) {
        this.codOpertation = codOpertation;
    }

    public Long getCodOpertation() {
        return codOpertation;
    }

  
    public void setMontant(Double montant) {
        this.Montant = montant;
    }

    public Double getMontant() {
        return Montant;
    }

    public void setNombre(Long nombre) {
        this.nombre = nombre;
    }

    public Long getNombre() {
        return nombre;
    }
}
