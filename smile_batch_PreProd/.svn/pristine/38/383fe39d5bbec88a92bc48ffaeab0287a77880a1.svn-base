package com.bna.smile.model.moyenPayement.model;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.oxia.fwk.core.ValueObject;

public class ParamAccuse extends ValueObject{
    public ParamAccuse() {
    }
    private Long refConsultation;
    private Long codeStructure;
    private Date dateJourneeComptable;
    private Date dateJourneeChargement;
    private Date dateConsultation;
    private String numMatrUser;
    private List<Accuse> listeAccusee=new ArrayList<Accuse>();
    private String nomRapport;

    public void setRefConsultation(Long refConsultation) {
        this.refConsultation = refConsultation;
    }

    public Long getRefConsultation() {
        return refConsultation;
    }

    public void setCodeStructure(Long codeStructure) {
        this.codeStructure = codeStructure;
    }

    public Long getCodeStructure() {
        return codeStructure;
    }

    public void setDateJourneeComptable(Date dateJourneeComptable) {
        this.dateJourneeComptable = dateJourneeComptable;
    }

    public Date getDateJourneeComptable() {
        return dateJourneeComptable;
    }

    public void setDateJourneeChargement(Date dateJourneeChargement) {
        this.dateJourneeChargement = dateJourneeChargement;
    }

    public Date getDateJourneeChargement() {
        return dateJourneeChargement;
    }

    public void setDateConsultation(Date dateConsultation) {
        this.dateConsultation = dateConsultation;
    }

    public Date getDateConsultation() {
        return dateConsultation;
    }

    public void setNumMatrUser(String numMatrUser) {
        this.numMatrUser = numMatrUser;
    }

    public String getNumMatrUser() {
        return numMatrUser;
    }

   public void setListeAccusee(List<Accuse> listeAccusee) {
        this.listeAccusee = listeAccusee;
    }

    public List<Accuse> getListeAccusee() {
        return listeAccusee;
    }

    public void setNomRapport(String nomRapport) {
        this.nomRapport = nomRapport;
    }

    public String getNomRapport() {
        return nomRapport;
    }

    
}
