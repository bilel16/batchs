package com.bna.smile.model.clotureDomaine.model;

import java.util.ArrayList;
import java.util.List;

import com.oxia.fwk.core.ValueObject;

public class LiquidationVo extends ValueObject{
    public LiquidationVo() {
    }
    
    private List liquidPart     = new ArrayList(0);
    private List liquidAvantEch     = new ArrayList(0);
    private List liquidArrivAEcheance     = new ArrayList(0);
    private List liquidTraitBatch     = new ArrayList(0);
    private Long nbrGlobliquidPart=new Long(0);
    private Double mntGlobliquidPart=new Double(0);
    private Long nbrGlobliqAVEch=new Long(0);
    private Double mntGlobliqAVEch=new Double(0);
    private Long nbrGlobliqBatch=new Long(0);
    private Double mntGlobliqBatch=new Double(0);


    public void setLiquidPart(List liquidPart) {
        this.liquidPart = liquidPart;
    }

    public List getLiquidPart() {
        return liquidPart;
    }

    public void setLiquidAvantEch(List liquidAvantEch) {
        this.liquidAvantEch = liquidAvantEch;
    }

    public List getLiquidAvantEch() {
        return liquidAvantEch;
    }

   

    public void setLiquidTraitBatch(List liquidTraitBatch) {
        this.liquidTraitBatch = liquidTraitBatch;
    }

    public List getLiquidTraitBatch() {
        return liquidTraitBatch;
    }

    public void setLiquidArrivAEcheance(List liquidArrivAEcheance) {
        this.liquidArrivAEcheance = liquidArrivAEcheance;
    }

    public List getLiquidArrivAEcheance() {
        return liquidArrivAEcheance;
    }

    public void setNbrGlobliquidPart(Long nbrGlobliquidPart) {
        this.nbrGlobliquidPart = nbrGlobliquidPart;
    }

    public Long getNbrGlobliquidPart() {
        return nbrGlobliquidPart;
    }

    public void setMntGlobliquidPart(Double mntGlobliquidPart) {
        this.mntGlobliquidPart = mntGlobliquidPart;
    }

    public Double getMntGlobliquidPart() {
        return mntGlobliquidPart;
    }

    public void setNbrGlobliqAVEch(Long nbrGlobliqAVEch) {
        this.nbrGlobliqAVEch = nbrGlobliqAVEch;
    }

    public Long getNbrGlobliqAVEch() {
        return nbrGlobliqAVEch;
    }

    public void setMntGlobliqAVEch(Double mntGlobliqAVEch) {
        this.mntGlobliqAVEch = mntGlobliqAVEch;
    }

    public Double getMntGlobliqAVEch() {
        return mntGlobliqAVEch;
    }

    public void setNbrGlobliqBatch(Long nbrGlobliqBatch) {
        this.nbrGlobliqBatch = nbrGlobliqBatch;
    }

    public Long getNbrGlobliqBatch() {
        return nbrGlobliqBatch;
    }

    public void setMntGlobliqBatch(Double mntGlobliqBatch) {
        this.mntGlobliqBatch = mntGlobliqBatch;
    }

    public Double getMntGlobliqBatch() {
        return mntGlobliqBatch;
    }
}
