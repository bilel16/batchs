package com.bna.smile.model.domainecontratcompte.modificationdonneesclient.model;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.oxia.fwk.core.ValueObject;
/**
 * @since 23/05/2008
 * @author Mdimagh Med Lassaad
 * 
 */
public class ParamListeMineursDevenusMajeursVo extends ValueObject {
    
    private Long codeStructure;
    private Date dateJour;
    private List listeDesMineursDevenusMajeurs = new ArrayList(0);
    
    public ParamListeMineursDevenusMajeursVo() {
    }


    public void setCodeStructure(Long codeStructure) {
        this.codeStructure = codeStructure;
    }

    public Long getCodeStructure() {
        return codeStructure;
    }

    public void setListeDesMineursDevenusMajeurs(List listeDesMineursDevenusMajeurs) {
        this.listeDesMineursDevenusMajeurs = listeDesMineursDevenusMajeurs;
    }

    public List getListeDesMineursDevenusMajeurs() {
        return listeDesMineursDevenusMajeurs;
    }

    public void setDateJour(Date dateJour) {
        this.dateJour = dateJour;
    }

    public Date getDateJour() {
        return dateJour;
    }
}
