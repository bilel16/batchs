package com.bna.smile.model.debutJournee.model;

import java.util.ArrayList;
import java.util.List;

import com.oxia.fwk.core.ValueObject;

public class DebutJourneeVo extends ValueObject{
    public DebutJourneeVo() {
    }
    private List listeSouscAttVAl      = new ArrayList(0);
    private List listeRenouvAtt    = new ArrayList(0);
    private List listeRenouvBatch    = new ArrayList(0);
    private List liquidTraitSoir    = new ArrayList(0);
    private List intPartVerseSoir    = new ArrayList(0);
    private List contratEchu5Jour    = new ArrayList(0);
    private List contratArriveeAEche    = new ArrayList(0);
    

    public void setListeSouscAttVAl(List listeSouscAttVAl) {
        this.listeSouscAttVAl = listeSouscAttVAl;
    }

    public List getListeSouscAttVAl() {
        return listeSouscAttVAl;
    }


   

    public void setLiquidTraitSoir(List liquidTraitSoir) {
        this.liquidTraitSoir = liquidTraitSoir;
    }

    public List getLiquidTraitSoir() {
        return liquidTraitSoir;
    }

    public void setIntPartVerseSoir(List intPartVerseSoir) {
        this.intPartVerseSoir = intPartVerseSoir;
    }

    public List getIntPartVerseSoir() {
        return intPartVerseSoir;
    }


    public void setContratEchu5Jour(List contratEchu5Jour) {
        this.contratEchu5Jour = contratEchu5Jour;
    }

    public List getContratEchu5Jour() {
        return contratEchu5Jour;
    }

    public void setContratArriveeAEche(List contratArriveeAEche) {
        this.contratArriveeAEche = contratArriveeAEche;
    }

    public List getContratArriveeAEche() {
        return contratArriveeAEche;
    }

    public void setListeRenouvAtt(List listeRenouvAtt) {
        this.listeRenouvAtt = listeRenouvAtt;
    }

    public List getListeRenouvAtt() {
        return listeRenouvAtt;
    }

    public void setListeRenouvBatch(List listeRenouvBatch) {
        this.listeRenouvBatch = listeRenouvBatch;
    }

    public List getListeRenouvBatch() {
        return listeRenouvBatch;
    }
}
