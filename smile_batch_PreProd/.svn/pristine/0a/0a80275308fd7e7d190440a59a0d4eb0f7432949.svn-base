package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;


import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.bna.commun.model.CertificationCheques;
import com.bna.commun.model.OperationMoyPay;
import com.bna.smile.model.domainecommun.model.ContratPersonne;
import com.oxia.fwk.core.ValueObject;

public class ParamDemandeChequeCertifie extends ValueObject {

    private Long CodStrcStrcDom;
    private Long CodStrcStrcInit;
    private Long CodEtatCchq;
    private String numCertCchq;
    private Long numChqCchq;
    private ContratPersonne contratPersonne;
    private Date dateDebut;
    private Date dateFin;
    private List ListeCerChqMandPers = new ArrayList();
    private CertificationCheques certificationCheques = 
        new CertificationCheques();
    private OperationMoyPay operationMoyPay = new OperationMoyPay();
    private String forcage;


    public ParamDemandeChequeCertifie() {
    }

    public void setCodEtatCchq(Long codEtatCchq) {
        this.CodEtatCchq = codEtatCchq;
    }

    public Long getCodEtatCchq() {
        return CodEtatCchq;
    }

    public void setCodStrcStrcInit(Long codStrcStrcInit) {
        this.CodStrcStrcInit = codStrcStrcInit;
    }

    public Long getCodStrcStrcInit() {
        return CodStrcStrcInit;
    }

    public void setCodStrcStrcDom(Long codStrcStrcDom) {
        this.CodStrcStrcDom = codStrcStrcDom;
    }

    public Long getCodStrcStrcDom() {
        return CodStrcStrcDom;
    }

    public void setNumCertCchq(String numCertCchq) {
        this.numCertCchq = numCertCchq;
    }

    public String getNumCertCchq() {
        return numCertCchq;
    }

    public void setContratPersonne(ContratPersonne contratPersonne) {
        this.contratPersonne = contratPersonne;
    }

    public ContratPersonne getContratPersonne() {
        return contratPersonne;
    }

    public void setDateDebut(Date dateDebut) {
        this.dateDebut = dateDebut;
    }

    public Date getDateDebut() {
        return dateDebut;
    }

    public void setDateFin(Date dateFin) {
        this.dateFin = dateFin;
    }

    public Date getDateFin() {
        return dateFin;
    }

    public void setNumChqCchq(Long numChqCchq) {
        this.numChqCchq = numChqCchq;
    }

    public Long getNumChqCchq() {
        return numChqCchq;
    }

    public void setListeCerChqMandPers(List listeCerChqMandPers) {
        this.ListeCerChqMandPers = listeCerChqMandPers;
    }

    public List getListeCerChqMandPers() {
        return ListeCerChqMandPers;
    }

    public void setCertificationCheques(CertificationCheques certificationCheques) {
        this.certificationCheques = certificationCheques;
    }

    public CertificationCheques getCertificationCheques() {
        return certificationCheques;
    }

    public void setOperationMoyPay(OperationMoyPay operationMoyPay) {
        this.operationMoyPay = operationMoyPay;
    }

    public OperationMoyPay getOperationMoyPay() {
        return operationMoyPay;
    }

    public void setForcage(String forcage) {
        this.forcage = forcage;
    }

    public String getForcage() {
        return forcage;
    }
}
