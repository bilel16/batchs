package com.bna.smile.model.domainecommun.model;

import com.oxia.fwk.core.ValueObject;

public class IdContratCpt extends ValueObject {

    private Integer codStrcStrc;
    private Integer codPrdPrd;
    private Integer numCcptCcpt;

    public IdContratCpt() {
    }

    public void setCodStrcStrc(Integer codStrcStrc) {
        this.codStrcStrc = codStrcStrc;
    }

    public Integer getCodStrcStrc() {
        return codStrcStrc;
    }

    public void setCodPrdPrd(Integer codPrdPrd) {
        this.codPrdPrd = codPrdPrd;
    }

    public Integer getCodPrdPrd() {
        return codPrdPrd;
    }

    public void setNumCcptCcpt(Integer numCcptCcpt) {
        this.numCcptCcpt = numCcptCcpt;
    }

    public Integer getNumCcptCcpt() {
        return numCcptCcpt;
    }
}
