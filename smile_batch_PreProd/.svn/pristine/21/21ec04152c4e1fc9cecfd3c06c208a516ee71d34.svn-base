    public String getLibEtatDemd() {
      if(this.codEtatDemd.equals("S"))
          libEtatDemd = "Saisie";
      else if(this.codEtatDemd.equals("V"))
          libEtatDemd = "validée";
      else if(this.codEtatDemd.equals("SV"))
          libEtatDemd = "saisie validée";
      else if(this.codEtatDemd.equals("E"))
          libEtatDemd = "etudiée";    
      else if(this.codEtatDemd.equals("EV"))
          libEtatDemd = "Etude Validée"; 
      else if(this.codEtatDemd.equals("N"))
          libEtatDemd = "Acceptée"; 
      else if(this.codEtatDemd.equals("R"))
            libEtatDemd = "rejetée"; 
        else if(this.codEtatDemd.equals("T"))
              libEtatDemd = "traitée";       
        return libEtatDemd;
    }

