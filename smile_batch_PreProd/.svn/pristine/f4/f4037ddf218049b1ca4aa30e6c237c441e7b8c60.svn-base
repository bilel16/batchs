package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;

import java.util.Date;

import com.oxia.fwk.core.ValueObject;


public class ParamRechercheOpposition extends ValueObject{

    private String typeOper;
    private Long typeMoyPaie;
    private String natureMoyPaie;
    
    private Long typPceDemd;
    private String numPceDemd;
    
    private Long codStrcStrc;
    private Long codPrdPrd;
    private Long numCcptCcpt;
    
    private Date dateDebutConsult;
    private Date dateFinConsult;
    
    private String numMoypTmoy;
    
    private String etat;
    private Long numSeqPers;
    
    
    public ParamRechercheOpposition() {
    }

    public void setNatureMoyPaie(String natureMoyPaie) {
        this.natureMoyPaie = natureMoyPaie;
    }

    public String getNatureMoyPaie() {
        return natureMoyPaie;
    }

    public void setNumPceDemd(String numPceDemd) {
        this.numPceDemd = numPceDemd;
    }

    public String getNumPceDemd() {
        return numPceDemd;
    }

    public void setCodStrcStrc(Long codStrcStrc) {
        this.codStrcStrc = codStrcStrc;
    }

    public Long getCodStrcStrc() {
        return codStrcStrc;
    }

    public void setCodPrdPrd(Long codPrdPrd) {
        this.codPrdPrd = codPrdPrd;
    }

    public Long getCodPrdPrd() {
        return codPrdPrd;
    }

    public void setNumCcptCcpt(Long numCcptCcpt) {
        this.numCcptCcpt = numCcptCcpt;
    }

    public Long getNumCcptCcpt() {
        return numCcptCcpt;
    }

    public void setTypeMoyPaie(Long typeMoyPaie) {
        this.typeMoyPaie = typeMoyPaie;
    }

    public Long getTypeMoyPaie() {
        return typeMoyPaie;
    }

    public void setTypPceDemd(Long typPceDemd) {
        this.typPceDemd = typPceDemd;
    }

    public Long getTypPceDemd() {
        return typPceDemd;
    }

    public void setDateDebutConsult(Date dateDebutConsult) {
        this.dateDebutConsult = dateDebutConsult;
    }

    public Date getDateDebutConsult() {
        return dateDebutConsult;
    }

    public void setDateFinConsult(Date dateFinConsult) {
        this.dateFinConsult = dateFinConsult;
    }

    public Date getDateFinConsult() {
        return dateFinConsult;
    }

    public void setTypeOper(String typeOper) {
        this.typeOper = typeOper;
    }

    public String getTypeOper() {
        return typeOper;
    }

    public void setNumMoypTmoy(String numMoypTmoy) {
        this.numMoypTmoy = numMoypTmoy;
    }

    public String getNumMoypTmoy() {
        return numMoypTmoy;
    }

    public void setEtat(String etat) {
        this.etat = etat;
    }

    public String getEtat() {
        return etat;
    }

    public void setNumSeqPers(Long numSeqPers) {
        this.numSeqPers = numSeqPers;
    }

    public Long getNumSeqPers() {
        return numSeqPers;
    }
}
