package com.bna.smile.model.domainecaisse.model;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.oxia.fwk.core.ValueObject;


public class ParamMvtCaisse extends ValueObject {

    private Long codeStructure;
    private String etat;
    private Date dateMvt;
    private Long codeOperation;
    private Long numeroCais;
    private List listMouvementForUpdate = new ArrayList();
    private List listMouvementForInsert = new ArrayList();
    
    private List listDetailCaissOriginForUpdate = new ArrayList();
    private List listDetailCaissReceptForInsert = new ArrayList();
    private List listDetailCaissReceptForUpdate = new ArrayList();
    
    
    
    public ParamMvtCaisse() {
    }

    public void setCodeStructure(Long codeStructure) {
        this.codeStructure = codeStructure;
    }

    public Long getCodeStructure() {
        return codeStructure;
    }

    public void setEtat(String etat) {
        this.etat = etat;
    }

    public String getEtat() {
        return etat;
    }

    public void setDateMvt(Date dateMvt) {
        this.dateMvt = dateMvt;
    }

    public Date getDateMvt() {
        return dateMvt;
    }

    public void setCodeOperation(Long codeOperation) {
        this.codeOperation = codeOperation;
    }

    public Long getCodeOperation() {
        return codeOperation;
    }

    public void setNumeroCais(Long numeroCais) {
        this.numeroCais = numeroCais;
    }

    public Long getNumeroCais() {
        return numeroCais;
    }

    public void setListMouvementForUpdate(List listMouvementForUpdate) {
        this.listMouvementForUpdate = listMouvementForUpdate;
    }

    public List getListMouvementForUpdate() {
        return listMouvementForUpdate;
    }

    public void setListDetailCaissOriginForUpdate(List listDetailCaissOriginForUpdate) {
        this.listDetailCaissOriginForUpdate = listDetailCaissOriginForUpdate;
    }

    public List getListDetailCaissOriginForUpdate() {
        return listDetailCaissOriginForUpdate;
    }

    public void setListDetailCaissReceptForInsert(List listDetailCaissReceptForInsert) {
        this.listDetailCaissReceptForInsert = listDetailCaissReceptForInsert;
    }

    public List getListDetailCaissReceptForInsert() {
        return listDetailCaissReceptForInsert;
    }

    public void setListDetailCaissReceptForUpdate(List listDetailCaissReceptForUpdate) {
        this.listDetailCaissReceptForUpdate = listDetailCaissReceptForUpdate;
    }

    public List getListDetailCaissReceptForUpdate() {
        return listDetailCaissReceptForUpdate;
    }

    public void setListMouvementForInsert(List listMouvementForInsert) {
        this.listMouvementForInsert = listMouvementForInsert;
    }

    public List getListMouvementForInsert() {
        return listMouvementForInsert;
    }
}
