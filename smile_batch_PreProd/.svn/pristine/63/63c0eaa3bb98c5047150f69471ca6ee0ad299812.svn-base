package com.bna.smile.web.banqueAssurance.View;

public class TarifAssVieView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {
    public TarifAssVieView() {
    }
    
    private String montPrmgTassView;
    private String montPrmaTassView;
    private String montComTassView;
    private String codPrdComptView;


    public void setMontPrmgTassView(String montPrmgTassView) {
        this.montPrmgTassView = montPrmgTassView;
    }

    public String getMontPrmgTassView() {
        return montPrmgTassView;
    }

    public void setMontPrmaTassView(String montPrmaTassView) {
        this.montPrmaTassView = montPrmaTassView;
    }

    public String getMontPrmaTassView() {
        return montPrmaTassView;
    }

    public void setMontComTassView(String montComTassView) {
        this.montComTassView = montComTassView;
    }

    public String getMontComTassView() {
        return montComTassView;
    }

    public void setCodPrdComptView(String codPrdComptView) {
        this.codPrdComptView = codPrdComptView;
    }

    public String getCodPrdComptView() {
        return codPrdComptView;
    }
}
