package com.bna.smile.web.placement.view;

import com.bna.commun.model.AbonnementPlacement;
import com.bna.commun.model.AvancRembLiquid;
import com.bna.commun.model.ContratPlacement;
import com.bna.commun.util.DateHandler;
import com.bna.commun.util.StrHandler;

public class AbonnementPlacementView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {
    public AbonnementPlacementView() {
    }
    
    private java.lang.Long numSeqAbpl;

            private ContratPlacement contratPlacement;

            private String datDebAbpl;

            private String datFinAbpl;

            private String datCompAbpl;

            private String datValAbpl;

            private String montAbplAbpl;

            private String montSintAbpl;

            private String numNbrjAbpl;

            private String codTypAbpl;

            private String codEtatAbpl;

            private String codPartAbpl;

            private String codToprAbpl;

            private AvancRembLiquid avancRembLiquid;

            private AbonnementPlacement abonnementPlacementM;

            private String montReajAbpl;

            private String montSreaAbpl;

            private String numTauiAbpl;

            private String codStrcAbpl;

    public void setNumSeqAbpl(Long numSeqAbpl) {
        this.numSeqAbpl = numSeqAbpl;
    }

    public Long getNumSeqAbpl() {
        return numSeqAbpl;
    }

    public void setContratPlacement(ContratPlacement contratPlacement) {
        this.contratPlacement = contratPlacement;
    }

    public ContratPlacement getContratPlacement() {
        return contratPlacement;
    }

    public void setDatDebAbpl(String datDebAbpl) {
        this.datDebAbpl = datDebAbpl;
    }

    public String getDatDebAbpl() {
        return datDebAbpl;
    }

    public void setDatFinAbpl(String datFinAbpl) {
        this.datFinAbpl = datFinAbpl;
    }

    public String getDatFinAbpl() {
        return datFinAbpl;
    }

    public void setDatCompAbpl(String datCompAbpl) {
        this.datCompAbpl = datCompAbpl;
    }

    public String getDatCompAbpl() {
        return datCompAbpl;
    }

    public void setDatValAbpl(String datValAbpl) {
        this.datValAbpl = datValAbpl;
    }

    public String getDatValAbpl() {
        return datValAbpl;
    }

    public void setMontAbplAbpl(String montAbplAbpl) {
        this.montAbplAbpl = montAbplAbpl;
    }

    public String getMontAbplAbpl() {
        return montAbplAbpl;
    }

    public void setMontSintAbpl(String montSintAbpl) {
        this.montSintAbpl = montSintAbpl;
    }

    public String getMontSintAbpl() {
        return montSintAbpl;
    }

    public void setNumNbrjAbpl(String numNbrjAbpl) {
        this.numNbrjAbpl = numNbrjAbpl;
    }

    public String getNumNbrjAbpl() {
        return numNbrjAbpl;
    }

    public void setCodTypAbpl(String codTypAbpl) {
        this.codTypAbpl = codTypAbpl;
    }

    public String getCodTypAbpl() {
        return codTypAbpl;
    }

    public void setCodEtatAbpl(String codEtatAbpl) {
        this.codEtatAbpl = codEtatAbpl;
    }

    public String getCodEtatAbpl() {
        return codEtatAbpl;
    }

    public void setCodPartAbpl(String codPartAbpl) {
        this.codPartAbpl = codPartAbpl;
    }

    public String getCodPartAbpl() {
        return codPartAbpl;
    }

    public void setCodToprAbpl(String codToprAbpl) {
        this.codToprAbpl = codToprAbpl;
    }

    public String getCodToprAbpl() {
        return codToprAbpl;
    }

    public void setAvancRembLiquid(AvancRembLiquid avancRembLiquid) {
        this.avancRembLiquid = avancRembLiquid;
    }

    public AvancRembLiquid getAvancRembLiquid() {
        return avancRembLiquid;
    }

    public void setAbonnementPlacementM(AbonnementPlacement abonnementPlacementM) {
        this.abonnementPlacementM = abonnementPlacementM;
    }

    public AbonnementPlacement getAbonnementPlacementM() {
        return abonnementPlacementM;
    }

    public void setMontReajAbpl(String montReajAbpl) {
        this.montReajAbpl = montReajAbpl;
    }

    public String getMontReajAbpl() {
        return montReajAbpl;
    }

    public void setMontSreaAbpl(String montSreaAbpl) {
        this.montSreaAbpl = montSreaAbpl;
    }

    public String getMontSreaAbpl() {
        return montSreaAbpl;
    }

    public void setNumTauiAbpl(String numTauiAbpl) {
        this.numTauiAbpl = numTauiAbpl;
    }

    public String getNumTauiAbpl() {
        return numTauiAbpl;
    }

    public void setCodStrcAbpl(String codStrcAbpl) {
        this.codStrcAbpl = codStrcAbpl;
    }

    public String getCodStrcAbpl() {
        return codStrcAbpl;
    }    public void copyAbonnement(AbonnementPlacement abb) {
        this.contratPlacement= abb.getContratPlacement();

     
        this.datDebAbpl=DateHandler.dateToStr(abb.getDatCompAbpl());
        this.datFinAbpl=DateHandler.dateToStr(abb.getDatFinAbpl());
        this.datCompAbpl=DateHandler.dateToStr(abb.getDatCompAbpl());
        this.datValAbpl=DateHandler.dateToStr(abb.getDatValAbpl());
        if (abb.getMontAbplAbpl()!=null)
        this.montAbplAbpl=StrHandler.formatmnt(abb.getMontAbplAbpl());
        if (abb.getMontSintAbpl()!=null)
        this.montSintAbpl=abb.getMontSintAbpl().toString();
        if (abb.getNumNbrjAbpl()!=null)
        this.numNbrjAbpl=abb.getNumNbrjAbpl().toString();
        this.codTypAbpl=abb.getCodTypAbpl();
        this.codEtatAbpl=abb.getCodEtatAbpl();
        this.codPartAbpl=abb.getCodPartAbpl();
        this.codToprAbpl=abb.getCodToprAbpl();
        this.avancRembLiquid=abb.getAvancRembLiquid() ;
        this.abonnementPlacementM=abb.getAbonnementPlacementM() ;
        if (abb.getMontReajAbpl()!=null)
        this.montReajAbpl=StrHandler.formatmnt(abb.getMontReajAbpl());
        if (abb.getMontSreaAbpl()!=null)
        this.montSreaAbpl=StrHandler.formatmnt(abb.getMontSreaAbpl());
        if (abb.getNumTauiAbpl()!=null)
        this.numTauiAbpl=abb.getNumTauiAbpl().toString();
        if (abb.getCodStrcAbpl()!=null)
        this.codStrcAbpl=abb.getCodStrcAbpl().toString();
    }
}
