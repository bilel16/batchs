package com.bna.smile.model.reporting.model;


import java.util.HashMap;
import java.util.Map;

public class CommonReportVO extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {
	
	private String rootFolder;
	private byte[] content;
	private Map params=new HashMap<String, Object>();
        private String nomReport;
        private String nomDossier;
        private String typeImpression="P";

	

	public Map getParams() {
		return params;
	}

	public void setParams(Map params) {
		this.params = params;
	}

	public String getRootFolder() {
		return rootFolder;
	}

	public void setRootFolder(String rootFolder) {
		this.rootFolder = rootFolder;
	}

	public byte[] getContent() {
		return content;
	}

	public void setContent(byte[] content) {
		this.content = content;
	}

    public void setNomReport(String nomReport) {
        this.nomReport = nomReport;
    }

    public String getNomReport() {
        return nomReport;
    }

    public void setTypeImpression(String typeImpression) {
        this.typeImpression = typeImpression;
    }

    public String getTypeImpression() {
        return typeImpression;
    }

    public void setNomDossier(String nomDossier) {
        this.nomDossier = nomDossier;
    }

    public String getNomDossier() {
        return nomDossier;
    }
	
	
}
