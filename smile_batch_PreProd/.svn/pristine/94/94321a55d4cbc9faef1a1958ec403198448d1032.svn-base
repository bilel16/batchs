package com.bna.smile.web.procuration.model;

import com.bna.commun.model.ContratCpt;


public class TraceMandatView  extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {

    private String numMandMand;
    private String codTypMand;
    private ContratCpt contratCpt;
    private String dateOper;
    private String numMatrUser;
    private String mandataires; 
    private String datDebMand;
    private String datFinMand;
    private String codOperOper;
    private String libOperOper;
    



    public TraceMandatView() {
    }

    public void setNumMandMand(String numMandMand) {
        this.numMandMand = numMandMand;
    }

    public String getNumMandMand() {
        return numMandMand;
    }

   

    public void setContratCpt(ContratCpt contratCpt) {
        this.contratCpt = contratCpt;
    }

    public ContratCpt getContratCpt() {
        return contratCpt;
    }

    public void setDateOper(String dateOper) {
        this.dateOper = dateOper;
    }

    public String getDateOper() {
        return dateOper;
    }

    public void setNumMatrUser(String numMatrUser) {
        this.numMatrUser = numMatrUser;
    }

    public String getNumMatrUser() {
        return numMatrUser;
    }

    public void setCodTypMand(String codTypMand) {
        this.codTypMand = codTypMand;
    }

    public String getCodTypMand() {
        return codTypMand;
    }


    public void setMandataires(String mandataires) {
        this.mandataires = mandataires;
    }

    public String getMandataires() {
        return mandataires;
    }

    public void setDatDebMand(String datDebMand) {
        this.datDebMand = datDebMand;
    }

    public String getDatDebMand() {
        return datDebMand;
    }

    public void setDatFinMand(String datFinMand) {
        this.datFinMand = datFinMand;
    }

    public String getDatFinMand() {
        return datFinMand;
    }

    public void setCodOperOper(String codOperOper) {
        this.codOperOper = codOperOper;
    }

    public String getCodOperOper() {
        return codOperOper;
    }

    public void setLibOperOper(String libOperOper) {
        this.libOperOper = libOperOper;
    }

    public String getLibOperOper() {
        return libOperOper;
    }
}
