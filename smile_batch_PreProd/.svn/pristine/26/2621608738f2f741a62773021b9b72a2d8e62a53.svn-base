<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:aop="http://www.springframework.org/schema/aop"
	xmlns:tx="http://www.springframework.org/schema/tx"
	xmlns:jee="http://www.springframework.org/schema/jee"
	xmlns:util="http://www.springframework.org/schema/util"
	xsi:schemaLocation="
	http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
	http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx-2.0.xsd
	http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-2.0.xsd
	http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util-2.0.xsd
	http://www.springframework.org/schema/jee http://www.springframework.org/schema/jee/spring-jee-2.0.xsd">

    <!-- JNDI DataSource for J2EE environments -->
    <!--bean id="dataSource" class="org.springframework.jndi.JndiObjectFactoryBean">
        <property name="jndiName"><value>java:comp/env/jdbc/appfuse</value></property>
    </bean-->
    
     <bean id="dataSourceHabil" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="${jdbc.url}"/>
        <property name="username" value="habil"/>
        <property name="password" value="habil"/>
        <property name="maxActive" value="100"/>
        <property name="maxIdle" value="30"/>
        <property name="maxWait" value="1000"/>
        <property name="defaultAutoCommit" value="true"/>
        <property name="removeAbandoned" value="true"/>
        <property name="removeAbandonedTimeout" value="60"/>
    </bean>
    
    <!-- Hibernate SessionFactory -->
    <bean id="sessionFactory1" class="org.springframework.orm.hibernate3.LocalSessionFactoryBean">
        <property name="dataSource" ref="dataSourceHabil"/>
        <property name="mappingResources">
            <list>
                    <value>com/oxia/security/abc/model/Role.hbm.xml</value>
                    <value>com/oxia/security/abc/model/Personnel.hbm.xml</value>
                    <value>com/oxia/security/abc/model/Application.hbm.xml</value>
                    <value>com/oxia/security/abc/model/Ressource.hbm.xml</value>
                    <value>com/oxia/security/abc/model/TypeRessource.hbm.xml</value>
                    <value>com/oxia/security/abc/model/Parametre.hbm.xml</value>
                    <value>com/oxia/security/abc/model/UserRole.hbm.xml</value>
                    <value>com/oxia/security/abc/model/RoleRessource.hbm.xml</value>
                    <value>com/oxia/security/abc/model/UserHistory.hbm.xml</value>
                    <value>com/oxia/security/abc/model/UserRoleHistory.hbm.xml</value>
                    <value>com/oxia/security/abc/model/RoleHistory.hbm.xml</value>
                    <value>com/oxia/security/abc/model/Interim.hbm.xml</value>
                    <value>com/oxia/security/abc/model/SegmentStructure.hbm.xml</value>
                    <value>com/oxia/security/abc/model/Fonction.hbm.xml</value>

            </list>
		</property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.dialect">org.hibernate.dialect.Oracle9Dialect</prop>
            </props>
        </property>
    </bean>

    <!-- Transaction manager for a single Hibernate SessionFactory (alternative to JTA) -->
    <bean id="transactionManager2" class="org.springframework.orm.hibernate3.HibernateTransactionManager">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>

    <!-- Generic Dao - can be used when doing standard CRUD -->
    <bean id="dao" class="com.oxia.security.abc.dao.hibernate.BaseDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>

    <!-- LookupDao: Hibernate implementation -->
    <bean id="lookupDao" class="com.oxia.security.abc.dao.hibernate.LookupDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>

    <!-- UserDao: Hibernate implementation -->
    <bean id="userDao" class="com.oxia.security.abc.dao.hibernate.UserDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
        <property name="dataSource" ref="dataSourceHabil"/>
    </bean>

    <!-- RoleDao: Hibernate implementation -->
    <bean id="roleDao" class="com.oxia.security.abc.dao.hibernate.RoleDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="operationDao" class="com.oxia.security.abc.dao.hibernate.OperationDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="groupeDao" class="com.oxia.security.abc.dao.hibernate.GroupeDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="applicationDao" class="com.oxia.security.abc.dao.hibernate.ApplicationDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="ressourceDao" class="com.oxia.security.abc.dao.hibernate.RessourceDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="typeRessourceDao" class="com.oxia.security.abc.dao.hibernate.TypeRessourceDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="parametreDao" class="com.oxia.security.abc.dao.hibernate.ParametreDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="profilDao" class="com.oxia.security.abc.dao.hibernate.ProfilDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    <bean id="interimDao" class="com.oxia.security.abc.dao.hibernate.InterimDaoHibernate">
        <property name="sessionFactory" ref="sessionFactory1"/>
    </bean>
    
    
    <bean id="businessImp" class="com.oxia.security.jdbc.BusinessImp">
            <property name="dataSource">
                <ref bean="dataSourceHabil" />
            </property>
            <property name="sqlQuery">
                <value>
                        <![CDATA[ select count(*) from   UTILISATEUR  ]]>
                </value>
            </property>
    </bean>
    
     
	 
    <!-- Add new Daos here -->
   

</beans>
