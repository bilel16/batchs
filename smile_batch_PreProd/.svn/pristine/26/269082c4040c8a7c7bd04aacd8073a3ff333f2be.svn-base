package com.bna.smile.model.domainecompensation.gestionrejet.model;


import com.oxia.fwk.core.ValueObject;

public class DecompteVo extends ValueObject {

	private static final long serialVersionUID = 1L;
	private String libFrais;
	private Long mntFrais;
	private String mntPayee;
	private Long numDecompte;

	public String getLibFrais() {
		return libFrais;
	}

	public void setLibFrais(String libFrais) {
		this.libFrais = libFrais;
	}

	public Long getMntFrais() {
		return mntFrais;
	}

	public void setMntFrais(Long mntFrais) {
		this.mntFrais = mntFrais;
	}

	public String getMntPayee() {
		return mntPayee;
	}

	public void setMntPayee(String mntPayee) {
		this.mntPayee = mntPayee;
	}

	public void setNumDecompte(Long numDecompte) {
		this.numDecompte = numDecompte;
	}

	public Long getNumDecompte() {
		return numDecompte;
	}

}
