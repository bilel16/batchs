package com.bna.smile.model.domaineplacement.model;

import java.util.Date;

import com.bna.smile.model.domainecommun.model.ContratPersonne;
import com.oxia.fwk.core.ValueObject;


public class ParamDemandeDecision extends ValueObject {

  
  
  private Long numRefdDemd;    
  private ContratPersonne contratPersonne = new ContratPersonne();
  private String natureDemande;  
  private String codEtatContrat; 
  private Long StructureDemande;
  private Long produitPlacement;
  private Date dateDebut;
  private Date dateFin;
  private String [] codEtatDemd = null;
  private Long [] codStrcStrc;
  private Long numSeqCpla;
  private Long numSeqPers;    
  private Long typeRenouvel;
  private Date dateLiquidation;
  private Date dateComptable;
  private Long etatRenouvellement;
  private String codPrdPrd;
  private String numCcptCcpt;
  private Long [] listeProduit = null;
  private String numBc;
  
    public ParamDemandeDecision() {
    }

    public void setContratPersonne(ContratPersonne contratPersonne) {
        this.contratPersonne = contratPersonne;
    }

    public ContratPersonne getContratPersonne() {
        return contratPersonne;
    }

    public void setNumRefdDemd(Long numRefdDemd) {
        this.numRefdDemd = numRefdDemd;
    }

    public Long getNumRefdDemd() {
        return numRefdDemd;
    }

  

    public void setNatureDemande(String natureDemande) {
        this.natureDemande = natureDemande;
    }

    public String getNatureDemande() {
        return natureDemande;
    }

    public void setCodEtatContrat(String codEtatContrat) {
        this.codEtatContrat = codEtatContrat;
    }

    public String getCodEtatContrat() {
        return codEtatContrat;
    }


   
    public void setProduitPlacement(Long produitPlacement) {
        this.produitPlacement = produitPlacement;
    }

    public Long getProduitPlacement() {
        return produitPlacement;
    }

    public void setDateDebut(Date dateDebut) {
        this.dateDebut = dateDebut;
    }

    public Date getDateDebut() {
        return dateDebut;
    }

    public void setDateFin(Date dateFin) {
        this.dateFin = dateFin;
    }

    public Date getDateFin() {
        return dateFin;
    }


    public void setCodEtatDemd(String[] codEtatDemd) {
        this.codEtatDemd = codEtatDemd;
    }

    public String[] getCodEtatDemd() {
        return codEtatDemd;
    }

    public void setStructureDemande(Long structureDemande) {
        this.StructureDemande = structureDemande;
    }

    public Long getStructureDemande() {
        return StructureDemande;
    }

    public void setCodStrcStrc(Long[] codStrcStrc) {
        this.codStrcStrc = codStrcStrc;
    }

    public Long[] getCodStrcStrc() {
        return codStrcStrc;
    }

    public void setNumSeqCpla(Long numSeqCpla) {
        this.numSeqCpla = numSeqCpla;
    }

    public Long getNumSeqCpla() {
        return numSeqCpla;
    }

    public void setNumSeqPers(Long numSeqPers) {
        this.numSeqPers = numSeqPers;
    }

    public Long getNumSeqPers() {
        return numSeqPers;
    }

    public void setTypeRenouvel(Long typeRenouvel) {
        this.typeRenouvel = typeRenouvel;
    }

    public Long getTypeRenouvel() {
        return typeRenouvel;
    }

    public void setDateLiquidation(Date dateLiquidation) {
        this.dateLiquidation = dateLiquidation;
    }

    public Date getDateLiquidation() {
        return dateLiquidation;
    }

    public void setDateComptable(Date dateComptable) {
        this.dateComptable = dateComptable;
    }

    public Date getDateComptable() {
        return dateComptable;
    }


    public void setEtatRenouvellement(Long etatRenouvellement) {
        this.etatRenouvellement = etatRenouvellement;
    }

    public Long getEtatRenouvellement() {
        return etatRenouvellement;
    }


    public void setCodPrdPrd(String codPrdPrd) {
        this.codPrdPrd = codPrdPrd;
    }

    public String getCodPrdPrd() {
        return codPrdPrd;
    }

    public void setNumCcptCcpt(String numCcptCcpt) {
        this.numCcptCcpt = numCcptCcpt;
    }

    public String getNumCcptCcpt() {
        return numCcptCcpt;
    }

    public void setListeProduit(Long[] listeProduit) {
        this.listeProduit = listeProduit;
    }

    public Long[] getListeProduit() {
        return listeProduit;
    }

    public void setNumBc(String numBc) {
        this.numBc = numBc;
    }

    public String getNumBc() {
