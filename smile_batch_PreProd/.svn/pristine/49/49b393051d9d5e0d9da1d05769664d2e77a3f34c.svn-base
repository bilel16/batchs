package com.bna.smile.model.domainecontratcompte.souscriptioncontratcompte.model;

import java.util.ArrayList;
import java.util.List;

import com.bna.commun.model.Client;
import com.oxia.fwk.core.ValueObject;

/** Fichier: ListeCotit.java version 1.0.0 du 24/01/2007
 * Copyright(c) 2006 BNA (www.bna.com.tn)
 * Classe: ListeCotit
 * package: com.bna.smile.model.souscriptionContratCompte.model
 * @author : Boussen Youssef & Kriaa Hatem
 */
public class ListeCotit extends ValueObject {

    private Client client;
    private List listePersonne = new ArrayList();
    private String codTcotCoti;
    private String codSigCoti;


    public ListeCotit() {
    }

    public void setClient(Client client) {
        this.client = client;
    }

    public Client getClient() {
        return client;
    }

    public void setListePersonne(List listePersonne) {
        this.listePersonne = listePersonne;
    }

    public List getListePersonne() {
        return listePersonne;
    }

    public void setCodTcotCoti(String codTcotCoti) {
        this.codTcotCoti = codTcotCoti;
    }

    public String getCodTcotCoti() {
        return codTcotCoti;
    }

    public void setCodSigCoti(String codSigCoti) {
        this.codSigCoti = codSigCoti;
    }

    public String getCodSigCoti() {
        return codSigCoti;
    }
}
