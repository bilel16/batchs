package com.bna.smile.model.clotureDomaine.model;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.bna.commun.model.JourneeStructureDomaineId;
import com.oxia.fwk.core.ValueObject;

public class StatPlacement extends ValueObject{
    public StatPlacement() {
    }
    private JourneeStructureDomaineId journeeStructureDomaineId;
    private Long structure;
    private Long produit;
    private Date dateJournee;
    private String etat;
    private List listeDemandeAtt=new ArrayList(0);
    private List listeDemandeVal=new ArrayList(0);
    private List listeDemandeEncour=new ArrayList(0);
    private List listeDemandeRej=new ArrayList(0);
    public void setStructure(Long structure) {
        this.structure = structure;
    }

    public Long getStructure() {
        return structure;
    }

    public void setProduit(Long produit) {
        this.produit = produit;
    }

    public Long getProduit() {
        return produit;
    }

    public void setDateJournee(Date dateJournee) {
        this.dateJournee = dateJournee;
    }

    public Date getDateJournee() {
        return dateJournee;
    }

    public void setEtat(String etat) {
        this.etat = etat;
    }

    public String getEtat() {
        return etat;
    }


    public void setListeDemandeAtt(List listeDemandeAtt) {
        this.listeDemandeAtt = listeDemandeAtt;
    }

    public List getListeDemandeAtt() {
        return listeDemandeAtt;
    }

    public void setListeDemandeVal(List listeDemandeVal) {
        this.listeDemandeVal = listeDemandeVal;
    }

    public List getListeDemandeVal() {
        return listeDemandeVal;
    }

    public void setListeDemandeEncour(List listeDemandeEncour) {
        this.listeDemandeEncour = listeDemandeEncour;
    }

    public List getListeDemandeEncour() {
        return listeDemandeEncour;
    }

    public void setListeDemandeRej(List listeDemandeRej) {
        this.listeDemandeRej = listeDemandeRej;
    }

    public List getListeDemandeRej() {
        return listeDemandeRej;
    }

    public void setJourneeStructureDomaineId(JourneeStructureDomaineId journeeStructureDomaineId) {
        this.journeeStructureDomaineId = journeeStructureDomaineId;
    }

    public JourneeStructureDomaineId getJourneeStructureDomaineId() {
        return journeeStructureDomaineId;
    }
}
