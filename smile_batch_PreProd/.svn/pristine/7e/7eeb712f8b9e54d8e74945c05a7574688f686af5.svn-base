package com.bna.smile.model.domainecommun.model;

import com.bna.commun.model.Personne;

import com.oxia.fwk.core.ValueObject;

import java.sql.Connection;

import java.util.ArrayList;
import java.util.List;

/** Classe de données permettant de communiquer les différentes données de la facturation SMS
 *  en charge
 *  @author El arbi hassine
 *  @since 25/07/2010
 *  @version 1.0
 *  */
public class  ParamSms extends ValueObject {
   
         
     /**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	private String codProduit;
     private String codeOperation;
     private String dateOperation;
     private String dateValeur;
     private String cin;
     private String numCompte;
     private Long numAbonnement;
     private Long montant;
     private Long tax;
     private String cycle;
     private Connection con = null;
     private Long ID;
     private Long codeAgence;

    /** Constructeur*/
    public
    ParamSms() {
    }


    public void setCodProduit(String codProduit) {
        this.codProduit = codProduit;
    }

    public String getCodProduit() {
        return codProduit;
    }


    public void setCodeOperation(String codeOperation) {
        this.codeOperation = codeOperation;
    }

    public String getCodeOperation() {
        return codeOperation;
    }

    public void setDateOperation(String dateOperation) {
        this.dateOperation = dateOperation;
    }

    public String getDateOperation() {
        return dateOperation;
    }

    public void setDateValeur(String dateValeur) {
        this.dateValeur = dateValeur;
    }

    public String getDateValeur() {
        return dateValeur;
    }

    public void setCin(String cin) {
        this.cin = cin;
    }

    public String getCin() {
        return cin;
    }

    public void setNumCompte(String numCompte) {
        this.numCompte = numCompte;
    }

    public String getNumCompte() {
        return numCompte;
    }

    public void setNumAbonnement(Long numAbonnement) {
        this.numAbonnement = numAbonnement;
    }

    public Long getNumAbonnement() {
        return numAbonnement;
    }

    public void setMontant(Long montant) {
        this.montant = montant;
    }

    public Long getMontant() {
        return montant;
    }

    public void setTax(Long tax) {
        this.tax = tax;
    }

    public Long getTax() {
        return tax;
    }

    public void setCycle(String cycle) {
        this.cycle = cycle;
    }

    public String getCycle() {
        return cycle;
    }

    public void setCon(Connection con) {
        this.con = con;
    }

    public Connection getCon() {
        return con;
    }

    public void setID(Long iD) {
        this.ID = iD;
    }

    public Long getID() {
        return ID;
    }


	public Long getCodeAgence() {
		return codeAgence;
	}


	public void setCodeAgence(Long codeAgence) {
		this.codeAgence = codeAgence;
	}
}
