package com.bna.smile.model.SMS.model;

import java.util.Date;

import com.oxia.fwk.core.ValueObject;

public class PowerCardSMS extends ValueObject {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private String numTelSal;
	private String textSmsSal;
	private Long etatEnvSms;
	private Date datEnvSms;
	private Long numSeqSms;
	/***************************/

	

	public PowerCardSMS() {
		super();
	}
	public PowerCardSMS(String numTelSal, String textSmsSal, Long etatEnvSms, Date datEnvSms, Long numSeqSms) {
		super();
		this.numTelSal = numTelSal;
		this.textSmsSal = textSmsSal;
		this.etatEnvSms = etatEnvSms;
		this.datEnvSms = datEnvSms;
		this.numSeqSms = numSeqSms;
	}
	/**************************/
	
	public String getNumTelSal() {
		return numTelSal;
	}

	
	public void setNumTelSal(String numTelSal) {
		this.numTelSal = numTelSal;
	}

	
	public String getTextSmsSal() {
		return textSmsSal;
	}

	
	public void setTextSmsSal(String textSmsSal) {
		this.textSmsSal = textSmsSal;
	}

	
	public Long getEtatEnvSms() {
		return etatEnvSms;
	}

	
	public void setEtatEnvSms(Long etatEnvSms) {
		this.etatEnvSms = etatEnvSms;
	}

	
	public Date getDatEnvSms() {
		return datEnvSms;
	}

	
	public void setDatEnvSms(Date datEnvSms) {
		this.datEnvSms = datEnvSms;
	}

	public Long getNumSeqSms() {
		return numSeqSms;
	}

	public void setNumSeqSms(Long numSeqSms) {
		this.numSeqSms = numSeqSms;
	}



}
