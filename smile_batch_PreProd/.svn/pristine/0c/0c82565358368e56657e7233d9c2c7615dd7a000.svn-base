package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;


import java.util.Date;

import com.bna.commun.model.CompteInterne;
import com.bna.smile.model.domainecommun.model.ContratPersonne;
import com.oxia.fwk.core.ValueObject;

public class ParamDemandeCheque extends ValueObject {

    private ContratPersonne contratPersonne;
    private CompteInterne compteInterne;
    private String numDemande;
    private Date dateDebut;
    private Date dateFin;
    private Long etatDemande;
    private String typeConfection;  
    private Long numMandMand;
    

    public ParamDemandeCheque() {
    }


    public void setContratPersonne(ContratPersonne contratPersonne) {
        this.contratPersonne = contratPersonne;
    }

    public ContratPersonne getContratPersonne() {
        return contratPersonne;
    }

  
    public void setDateDebut(Date dateDebut) {
        this.dateDebut = dateDebut;
    }

    public Date getDateDebut() {
        return dateDebut;
    }

 

   

    public void setTypeConfection(String typeConfection) {
        this.typeConfection = typeConfection;
    }

    public String getTypeConfection() {
        return typeConfection;
    }

    public void setDateFin(Date dateFin) {
        this.dateFin = dateFin;
    }

    public Date getDateFin() {
        return dateFin;
    }

    public void setEtatDemande(Long etatDemande) {
        this.etatDemande = etatDemande;
    }

    public Long getEtatDemande() {
        return etatDemande;
    }

  

    public void setNumMandMand(Long numMandMand) {
        this.numMandMand = numMandMand;
    }

    public Long getNumMandMand() {
        return numMandMand;
    }

    public void setNumDemande(String numDemande) {
        this.numDemande = numDemande;
    }

    public String getNumDemande() {
        return numDemande;
    }


    public void setCompteInterne(CompteInterne compteInterne) {
        this.compteInterne = compteInterne;
    }

    public CompteInterne getCompteInterne() {
        return compteInterne;
    }
}
