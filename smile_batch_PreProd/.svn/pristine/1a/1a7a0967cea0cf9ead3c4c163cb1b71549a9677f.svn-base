package com.bna.smile.model.domainecommun.model;

import com.bna.commun.model.Client;
import com.bna.commun.model.Personne;

import com.oxia.fwk.core.ValueObject;

import java.util.List;

/** Fichier: PersonneCpt.java version 1.0.0 du 22/01/2006
 * Copyright(c) 2006 BNA (www.bna.com.tn)
 * Classe: PersonneCpt
 * package: com.bna.smile.model.souscriptionContratCompte.model
 * Auteur : Boussen Youssef & Kriaa Hatem
 */
public class

PersonneCpt extends ValueObject {

    private Personne personne;
    private Client client;
    private List listeContratCpt;
    private Long codQualQual;

    public PersonneCpt() {
    }

    public void setPersonne(Personne personne) {
        this.personne = personne;
    }

    public Personne getPersonne() {
        return personne;
    }

    public void setListeContratCpt(List listeContratCpt) {
        this.listeContratCpt = listeContratCpt;
    }

    public List getListeContratCpt() {
        return listeContratCpt;
    }

    public void setClient(Client client) {
        this.client = client;
    }

    public Client getClient() {
        return client;
    }

    public void setCodQualQual(Long codQualQual) {
        this.codQualQual = codQualQual;
    }

    public Long getCodQualQual() {
        return codQualQual;
    }
}
