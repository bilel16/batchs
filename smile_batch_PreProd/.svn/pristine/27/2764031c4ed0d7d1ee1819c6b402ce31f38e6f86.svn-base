package com.bna.smile.model.domainecontratcompte.procuration.model;

import com.oxia.fwk.core.ValueObject;

public class StrConcern extends ValueObject {

    private Long codStrcStrc;
    private Long codStrcConcer;
    private String codTrait;


    public StrConcern() {
    }

    public void setCodStrcStrc(Long codStrcStrc) {
        this.codStrcStrc = codStrcStrc;
    }

    public Long getCodStrcStrc() {
        return codStrcStrc;
    }

    public void setCodStrcConcer(Long codStrcConcer) {
        this.codStrcConcer = codStrcConcer;
    }

    public Long getCodStrcConcer() {
        return codStrcConcer;
    }

    public void setCodTrait(String codTrait) {
        this.codTrait = codTrait;
    }

    public String getCodTrait() {
        return codTrait;
    }
}
