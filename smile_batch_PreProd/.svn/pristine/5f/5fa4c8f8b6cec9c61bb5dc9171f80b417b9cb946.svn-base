package com.bna.smile.model.domainecontratcompte.procuration.model;


import com.bna.commun.model.MandatPersonne;
import com.bna.commun.model.TraceMandat;
import com.oxia.fwk.core.ValueObject;

/**
 * Value Object qui contient 2 autres VO (TraceMandat & Mandataire)
 * @author Youssef BOUSSEN
 * @since 07/04/2008
 */

public class TraceMandataireSyncVO extends ValueObject{

    private TraceMandat traceMandat;
    private MandatPersonne mandatPersonne;


    public TraceMandataireSyncVO() {
    }

    public void setTraceMandat(TraceMandat traceMandat) {
        this.traceMandat = traceMandat;
    }

    public TraceMandat getTraceMandat() {
        return traceMandat;
    }

    public void setMandatPersonne(MandatPersonne mandatPersonne) {
        this.mandatPersonne = mandatPersonne;
    }

    public MandatPersonne getMandatPersonne() {
        return mandatPersonne;
    }
}
