package com.bna.smile.model.domainecompensation.gestionrejet.model;

import java.util.Date;

import com.oxia.fwk.core.ValueObject;

public class ReservationChqVo extends ValueObject {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private String codEtatRsv; // COD_ETAT_RESV;

	private Long codStrcStrc; // COD_STRC_STRC;
	private Long codPrdPrd; // COD_PRD_PRD;
	private Long numCcptCcpt; // NUM_CCPT_CCPT;
	private Long numChqChq; // NUM_CHQ_CHQ;
	private Long montantRsv; // MNT_RESV_RESV;
	private String ribTirChq; // RIB_TIR_CHQ;
	private String numOperOmp; // NUM_OPER_OMP;
	private Date dateConsultRsv; // DAT_CONSULT_RESV;
	private Date dateRsvRsv; // DAT_RESV_RESV;
	private Date dateFinRsv; // DAT_FIN_RESV;
	private Date dateExpirRsv; // DAT_EXPIR_RESV;

	/***********************************/
	public ReservationChqVo() {
		super();
	}

	/********************************/
	public String getCodEtatRsv() {
		return codEtatRsv;
	}

	public void setCodEtatRsv(String codEtatRsv) {
		this.codEtatRsv = codEtatRsv;
	}

	public Long getCodStrcStrc() {
		return codStrcStrc;
	}

	public void setCodStrcStrc(Long codStrcStrc) {
		this.codStrcStrc = codStrcStrc;
	}

	public Long getCodPrdPrd() {
		return codPrdPrd;
	}

	public void setCodPrdPrd(Long codPrdPrd) {
		this.codPrdPrd = codPrdPrd;
	}

	public Long getNumCcptCcpt() {
		return numCcptCcpt;
	}

	public void setNumCcptCcpt(Long numCcptCcpt) {
		this.numCcptCcpt = numCcptCcpt;
	}

	public Long getNumChqChq() {
		return numChqChq;
	}

	public void setNumChqChq(Long numChqChq) {
		this.numChqChq = numChqChq;
	}

	public Long getMontantRsv() {
		return montantRsv;
	}

	public void setMontantRsv(Long montantRsv) {
		this.montantRsv = montantRsv;
	}

	public String getRibTirChq() {
		return ribTirChq;
	}

	public void setRibTirChq(String ribTirChq) {
		this.ribTirChq = ribTirChq;
	}

	public String getNumOperOmp() {
		return numOperOmp;
	}

	public void setNumOperOmp(String numOperOmp) {
		this.numOperOmp = numOperOmp;
	}

	public Date getDateConsultRsv() {
		return dateConsultRsv;
	}

	public void setDateConsultRsv(Date dateConsultRsv) {
		this.dateConsultRsv = dateConsultRsv;
	}

	public Date getDateRsvRsv() {
		return dateRsvRsv;
	}

	public void setDateRsvRsv(Date dateRsvRsv) {
		this.dateRsvRsv = dateRsvRsv;
	}

	public Date getDateFinRsv() {
		return dateFinRsv;
	}

	public void setDateFinRsv(Date dateFinRsv) {
		this.dateFinRsv = dateFinRsv;
	}

	public Date getDateExpirRsv() {
		return dateExpirRsv;
	}

	public void setDateExpirRsv(Date dateExpirRsv) {
		this.dateExpirRsv = dateExpirRsv;
	}

}
