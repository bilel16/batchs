package com.bna.smile.web.operationguichet.view;

import com.bna.commun.model.DetailSessionCaisse;
import com.bna.commun.model.Personnel;


public class CaisseView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {

    private String cosStatSjc;
    private String datInitSjc;
    private String datCloSjc;
    private String cosTypSjc;
    private DetailSessionCaisse detailSessionCaisse;
    private Personnel personnel;
    private String numCaisCais;
    private String datJrnJrn;
    

    public CaisseView() {
    }

    public void setCosStatSjc(String cosStatSjc) {
        this.cosStatSjc = cosStatSjc;
    }

    public String getCosStatSjc() {
        return cosStatSjc;
    }

    public void setDatInitSjc(String datInitSjc) {
        this.datInitSjc = datInitSjc;
    }

    public String getDatInitSjc() {
        return datInitSjc;
    }

    public void setDatCloSjc(String datCloSjc) {
        this.datCloSjc = datCloSjc;
    }

    public String getDatCloSjc() {
        return datCloSjc;
    }

    public void setCosTypSjc(String cosTypSjc) {
        this.cosTypSjc = cosTypSjc;
    }

    public String getCosTypSjc() {
        return cosTypSjc;
    }

    public void setDetailSessionCaisse(DetailSessionCaisse detailSessionCaisse) {
        this.detailSessionCaisse = detailSessionCaisse;
    }

    public DetailSessionCaisse getDetailSessionCaisse() {
        return detailSessionCaisse;
    }

    public void setPersonnel(Personnel personnel) {
        this.personnel = personnel;
    }

    public Personnel getPersonnel() {
        return personnel;
    }

    public void setNumCaisCais(String numCaisCais) {
        this.numCaisCais = numCaisCais;
    }

    public String getNumCaisCais() {
        return numCaisCais;
    }

    public void setDatJrnJrn(String datJrnJrn) {
        this.datJrnJrn = datJrnJrn;
    }

    public String getDatJrnJrn() {
        return datJrnJrn;
    }
}
