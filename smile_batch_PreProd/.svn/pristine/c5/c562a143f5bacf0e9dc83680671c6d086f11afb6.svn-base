package com.bna.smile.model.traitementCompensationRecu.model;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.bna.commun.model.EffetRecuTmp;
import com.bna.commun.model.Structure;
import com.oxia.fwk.core.ValueObject;

public class ListEffetsRecusVo extends ValueObject implements Serializable {
    /**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	private Date   dateComptable;
    private String etat; 
    private Structure structure; // code de la structure
    private List<EffetRecuTmp>    listEffet21 = new ArrayList<EffetRecuTmp>();
    private List<EffetRecuTmp>    listEffet22 = new ArrayList<EffetRecuTmp>();
    private List<EffetRecuTmp>    listEffet25 = new ArrayList<EffetRecuTmp>();
    private Long codEnr ;

    public ListEffetsRecusVo() {
    }

	public Date getDateComptable() {
		return dateComptable;
	}

	public void setDateComptable(Date dateComptable) {
		this.dateComptable = dateComptable;
	}

	public String getEtat() {
		return etat;
	}

	public void setEtat(String etat) {
		this.etat = etat;
	}

	public Structure getStructure() {
		return structure;
	}

	public void setStructure(Structure structure) {
		this.structure = structure;
	}

	public List<EffetRecuTmp> getListEffet21() {
		return listEffet21;
	}

	public void setListEffet21(List<EffetRecuTmp> listEffet21) {
		this.listEffet21 = listEffet21;
	}

	public List<EffetRecuTmp> getListEffet22() {
		return listEffet22;
	}

	public void setListEffet22(List<EffetRecuTmp> listEffet22) {
		this.listEffet22 = listEffet22;
	}

	public List<EffetRecuTmp> getListEffet25() {
		return listEffet25;
	}

	public void setListEffet25(List<EffetRecuTmp> listEffet25) {
		this.listEffet25 = listEffet25;
	}

	public void setCodEnr(Long codEnr) {
		this.codEnr = codEnr;
	}

	public Long getCodEnr() {
		return codEnr;
	}

    

	
}
