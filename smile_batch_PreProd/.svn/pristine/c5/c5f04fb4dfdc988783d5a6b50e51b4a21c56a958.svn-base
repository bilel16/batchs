package com.bna.smile.model.domainecommun.service;

import com.oxia.fwk.beans.service.BasicService;
import com.oxia.fwk.core.IValueObject;


public class CRUDservice extends BasicService {
    public void create(IValueObject iValueObject) {
        super.execute(iValueObject, BasicService.BASIC_CREATE_ACTION);
    }

    public void update(IValueObject iValueObject) {
        super.execute(iValueObject, BasicService.BASIC_UPDATE_ACTION);
    }

    public void remove(IValueObject iValueObject) {
        super.execute(iValueObject, BasicService.BASIC_REMOVE_ACTION);
    }
}
