package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;

import java.util.ArrayList;
import java.util.List;

import com.oxia.fwk.core.ValueObject;

public class ListeNatureMoyPaie extends ValueObject {

    List  listCheque= new ArrayList();
    List  listCarte= new ArrayList();
    
    public ListeNatureMoyPaie() {
    }

    public void setListCheque(List listCheque) {
        this.listCheque = listCheque;
    }

    public List getListCheque() {
        return listCheque;
    }

    public void setListCarte(List listCarte) {
        this.listCarte = listCarte;
    }

    public List getListCarte() {
        return listCarte;
    }
}
