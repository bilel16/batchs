
package com.bna.smile.model.domainecommun.model;

import com.oxia.fwk.core.IValueObject;
import com.oxia.fwk.core.ValueObject;

/** Fichier: PersonneStrc.java version 1.0.0 du 22/01/2006
 * Copyright(c) 2006 BNA (www.bna.com.tn)
 * Classe: PersonneStrc
 * package: com.bna.smile.model.souscriptionContratCompte.model
 * Auteur : Boussen Youssef & Kriaa Hatem
 */
public class PersonneStrc extends ValueObject implements java.io.Serializable{

    private Long codTpceTpce;
    private String numPcePers;
    private Long codStrcStrc;
    private String casModificationDonnees; // ajouter par lassaad le 08/08/08 pour tester les mandats
    private String code;
    private String casNotificationDeces;
    private Long numDosJur;
    private Long codStrcJur;
    public PersonneStrc() {
    }


    public void setNumPcePers(String numPcePers) {
        this.numPcePers = numPcePers;
    }

    public String getNumPcePers() {
        return numPcePers;
    }

    public void setCodStrcStrc(Long codStrcStrc) {
        this.codStrcStrc = codStrcStrc;
    }

    public Long getCodStrcStrc() {
        return codStrcStrc;
    }

    public void setCodTpceTpce(Long codTpceTpce) {
        this.codTpceTpce = codTpceTpce;
    }

    public Long getCodTpceTpce() {
        return codTpceTpce;
    }


    public void setCode(String code) {
        this.code = code;
    }

    public String getCode() {
        return code;
    }

    public void setCasModificationDonnees(String casModificationDonnees) {
        this.casModificationDonnees = casModificationDonnees;
    }

    public String getCasModificationDonnees() {
        return casModificationDonnees;
    }

    public void setCasNotificationDeces(String casNotificationDeces) {
        this.casNotificationDeces = casNotificationDeces;
    }

    public String getCasNotificationDeces() {
        return casNotificationDeces;
    }

    public void setNumDosJur(Long numDosJur) {
        this.numDosJur = numDosJur;
    }

    public Long getNumDosJur() {
        return numDosJur;
    }

    public void setCodStrcJur(Long codStrcJur) {
        this.codStrcJur = codStrcJur;
    }

    public Long getCodStrcJur() {
        return codStrcJur;
    }
}
