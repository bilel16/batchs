package com.bna.smile.model.domainecommun.model;

import com.oxia.fwk.core.ValueObject;

import java.util.Date;

/** Fichier: PersonneRechercheContratVo.java version 1.0.0 du 22/01/2006
 * Copyright(c) 2006 BNA (www.bna.com.tn)
 * Classe: PersonneRechercheContratVo
 * package: com.bna.smile.model.souscriptionContratCompte.model
 * Auteur : Ramzi
 */
public class PersonneRechercheContratVo  extends ValueObject {

    private PersonneStrc personneStrc;
    private String etatContrat;
    private Date dateDebut;    
    private Date dateFin;
    private String codeAgence;
    private String typePersonne;
    
    
    public PersonneRechercheContratVo() {
    }

    public void setPersonneStrc(PersonneStrc personneStrc) {
        this.personneStrc = personneStrc;
    }

    public PersonneStrc getPersonneStrc() {
        return personneStrc;
    }

    public void setEtatContrat(String etatContrat) {
        this.etatContrat = etatContrat;
    }

    public String getEtatContrat() {
        return etatContrat;
    }

    public void setDateDebut(Date dateDebut) {
        this.dateDebut = dateDebut;
    }

    public Date getDateDebut() {
        return dateDebut;
    }

    public void setDateFin(Date dateFin) {
        this.dateFin = dateFin;
    }

    public Date getDateFin() {
        return dateFin;
    }

    public void setCodeAgence(String codeAgence) {
        this.codeAgence = codeAgence;
    }

    public String getCodeAgence() {
        return codeAgence;
    }

    public void setTypePersonne(String typePersonne) {
        this.typePersonne = typePersonne;
    }

    public String getTypePersonne() {
        return typePersonne;
    }
}
