package com.bna.smile.web.operationguichet.view;

public class DetailSessionCaisseView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable{
   
    private String montDebDsc;
    private String montToteDsc;
    private String montTotsDsc;
    private String montFinDsc; ///*** montDebDsc+montToteDsc-montTotsDsc
    private String codNatuDsc;
    private String libSiglDev;
    private String codDevDev;
    private String montAllDsc; ///*** montant allouél a une caisse de vacation
    private String numCaisCibl;///*** N° de la caisse cible lors de l'envoi de fond
    
    public DetailSessionCaisseView() {
    }

    public void setMontDebDsc(String montDebDsc) {
        this.montDebDsc = montDebDsc;
    }

    public String getMontDebDsc() {
        return montDebDsc;
    }

    public void setMontToteDsc(String montToteDsc) {
        this.montToteDsc = montToteDsc;
    }

    public String getMontToteDsc() {
        return montToteDsc;
    }

    public void setMontTotsDsc(String montTotsDsc) {
        this.montTotsDsc = montTotsDsc;
    }

    public String getMontTotsDsc() {
        return montTotsDsc;
    }

    public void setCodNatuDsc(String codNatuDsc) {
        this.codNatuDsc = codNatuDsc;
    }

    public String getCodNatuDsc() {
        return codNatuDsc;
    }

    public void setLibSiglDev(String libSiglDev) {
        this.libSiglDev = libSiglDev;
    }

    public String getLibSiglDev() {
        return libSiglDev;
    }

    public void setCodDevDev(String codDevDev) {
        this.codDevDev = codDevDev;
    }

    public String getCodDevDev() {
        return codDevDev;
    }

    public void setMontAllDsc(String montAllDsc) {
        this.montAllDsc = montAllDsc;
    }

    public String getMontAllDsc() {
        return montAllDsc;
    }

    public void setMontFinDsc(String montFinDsc) {
        this.montFinDsc = montFinDsc;
    }

    public String getMontFinDsc() {
        return montFinDsc;
    }

    public void setNumCaisCibl(String numCaisCibl) {
        this.numCaisCibl = numCaisCibl;
    }

    public String getNumCaisCibl() {
        return numCaisCibl;
    }
}
