package com.bna.smile.model.prelevement.model;

import java.util.Date;

import com.oxia.fwk.core.ValueObject;

public class ADDomiciliationVo extends ValueObject {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private Long numLot; // NUMBER(4)
	private Date datOpe; // DATE
	private Long mntTot; // NUMBER(18,3)
	private Long nbrTot; // NUMBER(10)
	private Integer codSen; // NUMBER(1)
	private String codAge; // VARCHAR2(10)
	private String codBan; // VARCHAR2(10)
	private Integer codVal; // NUMBER(2)
	private Integer codNatEta; // NUMBER(1)
	private String codDev; // VARCHAR2(3)
	private Integer codEnr; // NUMBER(2)
	private String refFic; // VARCHAR2(100)
	private String codSta; // VARCHAR2(5)
	private Date datEnvPa; // DATE
	private String refLot; // VARCHAR2(9)

	// *********Setter and Getter***************//

	public Long getNumLot() {
		return numLot;
	}

	public void setNumLot(Long numLot) {
		this.numLot = numLot;
	}

	public Date getDatOpe() {
		return datOpe;
	}

	public void setDatOpe(Date datOpe) {
		this.datOpe = datOpe;
	}

	public Long getMntTot() {
		return mntTot;
	}

	public void setMntTot(Long mntTot) {
		this.mntTot = mntTot;
	}

	public Long getNbrTot() {
		return nbrTot;
	}

	public void setNbrTot(Long nbrTot) {
		this.nbrTot = nbrTot;
	}

	public Integer getCodSen() {
		return codSen;
	}

	public void setCodSen(Integer codSen) {
		this.codSen = codSen;
	}

	public String getCodAge() {
		return codAge;
	}

	public void setCodAge(String codAge) {
		this.codAge = codAge;
	}

	public String getCodBan() {
		return codBan;
	}

	public void setCodBan(String codBan) {
		this.codBan = codBan;
	}

	public Integer getCodVal() {
		return codVal;
	}

	public void setCodVal(Integer codVal) {
		this.codVal = codVal;
	}

	public Integer getCodNatEta() {
		return codNatEta;
	}

	public void setCodNatEta(Integer codNatEta) {
		this.codNatEta = codNatEta;
	}

	public String getCodDev() {
		return codDev;
	}

	public void setCodDev(String codDev) {
		this.codDev = codDev;
	}

	public Integer getCodEnr() {
		return codEnr;
	}

	public void setCodEnr(Integer codEnr) {
		this.codEnr = codEnr;
	}

	public String getRefFic() {
		return refFic;
	}

	public void setRefFic(String refFic) {
		this.refFic = refFic;
	}

	public String getCodSta() {
		return codSta;
	}

	public void setCodSta(String codSta) {
		this.codSta = codSta;
	}

	public Date getDatEnvPa() {
		return datEnvPa;
	}

	public void setDatEnvPa(Date datEnvPa) {
		this.datEnvPa = datEnvPa;
	}

	public String getRefLot() {
		return refLot;
	}

	public void setRefLot(String refLot) {
		this.refLot = refLot;
	}

}
