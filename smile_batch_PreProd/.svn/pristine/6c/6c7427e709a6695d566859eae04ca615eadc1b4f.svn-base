	}

	public void setRefOperation(String refOperation) {
		this.refOperation = refOperation;
	}

	public String getMontantOperation() {
		return montantOperation;
	}

	public void setMontantOperation(String montantOperation) {
		this.montantOperation = montantOperation;
	}

	public void setSoldeDeprt(Long soldeDeprt) {
		this.soldeDeprt = soldeDeprt;
	}

	public Long getSoldeDeprt() {
		return soldeDeprt;
	}

