	}

	public void setMontantTVA(Long montantTVA) {
		this.montantTVA = montantTVA;
	}

	public Long getMontantTVA() {
		return montantTVA;
	}

	public void setMontantCommission(Long montantCommission) {
		this.montantCommission = montantCommission;
	}

