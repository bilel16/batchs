package com.bna.smile.web.procuration.util;

import com.bna.commun.model.MandatOperation;

/**
 * Classe qui represente l'objet Mnadat Operation, elle utilisée 
 * pour l'affichage dans les pages JSP
 * @author Mdimagh Lassaad
 */
public class MandatOperationView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {
    private MandatOperation mandatOperation;
    private String typeSignature;
    private String dateDebutOperation;
    private String dateDebutPeriode;
    private String dateFinOperation;
    private String montantLimite;
    private String montantEnveloppe;
    private String montantUtilise;
    private String nombreMinimum;
       
    public MandatOperationView() {
    }

    public void setMandatOperation(MandatOperation mandatOperation) {
        this.mandatOperation = mandatOperation;
    }

    public MandatOperation getMandatOperation() {
        return mandatOperation;
    }

    public void setTypeSignature(String typeSignature) {
        this.typeSignature = typeSignature;
    }

    public String getTypeSignature() {
        return typeSignature;
    }

    public void setDateDebutOperation(String dateDebutOperation) {
        this.dateDebutOperation = dateDebutOperation;
    }

    public String getDateDebutOperation() {
        return dateDebutOperation;
    }

    public void setDateDebutPeriode(String dateDebutPeriode) {
        this.dateDebutPeriode = dateDebutPeriode;
    }

    public String getDateDebutPeriode() {
        return dateDebutPeriode;
    }

    public void setDateFinOperation(String dateFinOperation) {
        this.dateFinOperation = dateFinOperation;
    }

    public String getDateFinOperation() {
        return dateFinOperation;
    }

    public void setMontantLimite(String montantLimite) {
        this.montantLimite = montantLimite;
    }

    public String getMontantLimite() {
        return montantLimite;
    }

    public void setMontantEnveloppe(String montantEnveloppe) {
        this.montantEnveloppe = montantEnveloppe;
    }

    public String getMontantEnveloppe() {
        return montantEnveloppe;
    }

    public void setMontantUtilise(String montantUtilise) {
        this.montantUtilise = montantUtilise;
    }

    public String getMontantUtilise() {
        return montantUtilise;
    }

    public void setNombreMinimum(String nombreMinimum) {
        this.nombreMinimum = nombreMinimum;
    }

    public String getNombreMinimum() {
        return nombreMinimum;
    }
}
