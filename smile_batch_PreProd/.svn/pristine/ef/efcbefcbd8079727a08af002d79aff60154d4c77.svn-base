package com.bna.smile.model.domainecontratcompte.procuration.model;
         

import com.bna.commun.model.Mandat;
import com.bna.commun.model.Personnel;
import com.bna.smile.model.domainecontratcompte.souscriptioncontratcompte.model.ParamInsertContrat;
import com.oxia.fwk.core.ValueObject;


public class ParamInsertMandat extends ValueObject {
    public ParamInsertMandat() {
    }

    private Mandat mandat;
    private ParamInsertContrat paramInsertContrat;
    private Personnel personnel;
    private String typeValidation;
    public void setMandat(Mandat mandat) {
        this.mandat = mandat;
    }

    public Mandat getMandat() {
        return mandat;
    }

    public void setParamInsertContrat(ParamInsertContrat paramInsertContrat) {
        this.paramInsertContrat = paramInsertContrat;
    }

    public ParamInsertContrat getParamInsertContrat() {
        return paramInsertContrat;
    }

   

    public void setTypeValidation(String typeValidation) {
        this.typeValidation = typeValidation;
    }

    public String getTypeValidation() {
        return typeValidation;
    }

    public void setPersonnel(Personnel personnel) {
        this.personnel = personnel;
    }

    public Personnel getPersonnel() {
        return personnel;
    }
}
