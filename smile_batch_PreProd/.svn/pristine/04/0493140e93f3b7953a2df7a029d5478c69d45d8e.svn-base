package com.bna.smile.model.domainecontratcompte.moyensPaiement.model;

import com.bna.commun.model.ContratCptId;
import com.oxia.fwk.core.ValueObject;

public class Paramchequiers extends ValueObject{

    private ContratCptId contratCptId;
    private Long numChequier;
    private String numDemande;

    public Paramchequiers() {
    }

    public void setContratCptId(ContratCptId contratCptId) {
        this.contratCptId = contratCptId;
    }

    public ContratCptId getContratCptId() {
        return contratCptId;
    }

    public void setNumChequier(Long numChequier) {
        this.numChequier = numChequier;
    }

    public Long getNumChequier() {
        return numChequier;
    }

    public void setNumDemande(String numDemande) {
        this.numDemande = numDemande;
    }

    public String getNumDemande() {
        return numDemande;
    }
}
