public class CoursChangeView extends com.oxia.fwk.core.ValueObject implements java.io.Serializable {

    private String datCoursChange;
    private String coursAvhatBna;
    private String coursVenteBna;
    private String codDevise;
    private String libDevise;
    private String coursAchatBct;
    private String coursVenteBct;
    
   
   
   
   
    public CoursChangeView() {
      
    }


    public void setDatCoursChange(String datCoursChange) {
        this.datCoursChange = datCoursChange;
    }

    public String getDatCoursChange() {
        return datCoursChange;
    }

    public void setCoursAvhatBna(String coursAvhatBna) {
        this.coursAvhatBna = coursAvhatBna;
    }

    public String getCoursAvhatBna() {
        return coursAvhatBna;
    }

    public void setCoursVenteBna(String coursVenteBna) {
        this.coursVenteBna = coursVenteBna;
    }

    public String getCoursVenteBna() {
        return coursVenteBna;
    }

    public void setCodDevise(String codDevise) {
        this.codDevise = codDevise;
    }

    public String getCodDevise() {
        return codDevise;
    }

    public void setLibDevise(String libDevise) {
        this.libDevise = libDevise;
    }

    public String getLibDevise() {
        return libDevise;
    }

    public void setCoursAchatBct(String coursAchatBct) {
        this.coursAchatBct = coursAchatBct;
    }

    public String getCoursAchatBct() {
        return coursAchatBct;
    }

    public void setCoursVenteBct(String coursVenteBct) {
        this.coursVenteBct = coursVenteBct;
    }

    public String getCoursVenteBct() {
        return coursVenteBct;
    }
}
