package com.bna.smile.model.clotureDomaine.model;

import java.util.Date;

import com.oxia.fwk.core.ValueObject;

public class PramDetailPlacVo extends ValueObject {
    public PramDetailPlacVo() {
    }
    
    private Long codeStructure;
    private Date dateCreation;
    private Date datevalidation;
    private Date dateRejet;
    private Date dateEcheance;
    private Date dateSup;
    private String Etat;
    private Long codeProduit;
    private String typedem;
    private String typeCond;
    private Long structureValid;
    private Long codTyprDemd;
    private Date dateLiquidation;
    private Date dateInfLiq;
    private Date dateSupLiq;

    public void setCodeStructure(Long codeStructure) {
        this.codeStructure = codeStructure;
    }

    public Long getCodeStructure() {
        return codeStructure;
    }

    public void setDateCreation(Date dateCreation) {
        this.dateCreation = dateCreation;
    }

    public Date getDateCreation() {
        return dateCreation;
    }

    public void setDatevalidation(Date datevalidation) {
        this.datevalidation = datevalidation;
    }

    public Date getDatevalidation() {
        return datevalidation;
    }

    public void setEtat(String etat) {
        this.Etat = etat;
    }

    public String getEtat() {
        return Etat;
    }

    public void setCodeProduit(Long codeProduit) {
        this.codeProduit = codeProduit;
    }

    public Long getCodeProduit() {
        return codeProduit;
    }

    public void setTypedem(String typedem) {
        this.typedem = typedem;
    }

    public String getTypedem() {
        return typedem;
    }

    public void setTypeCond(String typeCond) {
        this.typeCond = typeCond;
    }

    public String getTypeCond() {
        return typeCond;
    }

    public void setStructureValid(Long structureValid) {
        this.structureValid = structureValid;
    }

    public Long getStructureValid() {
        return structureValid;
    }

    public void setDateRejet(Date dateRejet) {
        this.dateRejet = dateRejet;
    }

    public Date getDateRejet() {
        return dateRejet;
    }

    public void setDateEcheance(Date dateEcheance) {
        this.dateEcheance = dateEcheance;
    }

    public Date getDateEcheance() {
        return dateEcheance;
    }

    public void setCodTyprDemd(Long codTyprDemd) {
        this.codTyprDemd = codTyprDemd;
    }

    public Long getCodTyprDemd() {
        return codTyprDemd;
    }

    public void setDateLiquidation(Date dateLiquidation) {
        this.dateLiquidation = dateLiquidation;
    }

    public Date getDateLiquidation() {
        return dateLiquidation;
    }

    public void setDateSup(Date dateSup) {
        this.dateSup = dateSup;
    }

    public Date getDateSup() {
        return dateSup;
    }

    public void setDateInfLiq(Date dateInfLiq) {
        this.dateInfLiq = dateInfLiq;
    }

    public Date getDateInfLiq() {
        return dateInfLiq;
    }

    public void setDateSupLiq(Date dateSupLiq) {
        this.dateSupLiq = dateSupLiq;
    }

    public Date getDateSupLiq() {
        return dateSupLiq;
    }
