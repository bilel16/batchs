		<property name="hibernateProperties">
			<props>
				<prop key="hibernate.dialect">org.hibernate.dialect.Oracle9Dialect</prop>
				<prop key="hibernate.show_sql">false</prop>
				<prop key="hibernate.cglib.use_reflection_optimizer">true</prop>
				<prop key="hibernate.cache.provider_class">org.hibernate.cache.HashtableCacheProvider</prop>
				<prop key="hibernate.max_fetch_depth">2</prop>
			</props>
		</property>

		<property name="dataSource">
			<ref bean="dataSource" />
		</property>
	</bean>

	<!-- Hibernate Template Configuration ***************************************** 
		***************************************** ***************************************** -->
	<bean id="hibernateTemplate"
		class="org.springframework.orm.hibernate3.HibernateTemplate"
		lazy-init="true">
		<property name="sessionFactory">
			<ref bean="sessionFactory" />
		</property>
	</bean>

	<!-- Framework Configuration ******************************* ******************************* 
		******************************* -->
	<bean id="basicActionImpl" class="com.oxia.daoImpl.Hibernate3Impl"
		lazy-init="true">
		<property name="hibernateTemplate">
			<ref bean="hibernateTemplate" />
		</property>
	</bean>

	<bean id="createBasic"
		class="com.oxia.fwk.beans.integration.BasicCreateDAO" lazy-init="true">
		<property name="basicAction">
			<ref bean="basicActionImpl" />
		</property>
	</bean>

	<bean id="updateBasic"
		class="com.oxia.fwk.beans.integration.BasicUpdateDAO" lazy-init="true">
		<property name="basicAction">
			<ref bean="basicActionImpl" />
		</property>
	</bean>

	<bean id="removeBasic"
		class="com.oxia.fwk.beans.integration.BasicRemoveDAO" lazy-init="true">
		<property name="basicAction">
			<ref bean="basicActionImpl" />
		</property>
	</bean>

	<!-- Transaction manager Configuration ***************************************** 
		***************************************** ***************************************** -->
	<bean id="transactionManager"
		class="org.springframework.orm.hibernate3.HibernateTransactionManager"
		abstract="false" lazy-init="false" autowire="default"
		dependency-check="default">
		<property name="sessionFactory" ref="sessionFactory" />
	</bean>


	<!-- Basic service configuration ***************************************** 
		***************************************** ***************************************** -->
	<bean id="basicService"
		class="com.oxia.fwk.beans.service.BasicService" lazy-init="true">

		<property name="daoCreate">
			<ref bean="createBasic" />
		</property>

		<property name="daoRemove">
			<ref bean="removeBasic" />
		</property>

		<property name="daoUpdate">
			<ref bean="updateBasic" />
		</property>

	</bean>

	<!-- Crud Service configuration ***************************************** 
		***************************************** ***************************************** -->
	<bean id="crudservice" parent="txProxyTemplate">
		<property name="target">
			<bean
				class="com.bna.smile.model.domainecommun.service.CRUDservice"
				parent="basicService">
			</bean>
		</property>
	</bean>
	<bean id="crudserviceFrw" parent="txProxyTemplate">
		<property name="target">
			<bean class="com.oxia.fwk.crudservice.CrudService"
				parent="basicService">
			</bean>
		</property>
	</bean>

	<bean id="CURService" parent="txProxyTemplate">
		<property name="target">
			<bean class="com.bna.commun.service.CURService"
				parent="basicService">
			</bean>
		</property>
	</bean>

	<bean id="crudservice1"
		class="com.bna.smile.model.domainecommun.service.CRUDservice"
		parent="basicService" lazy-init="true" />

	<!-- Search Engine configuration ***************************************** 
		***************************************** ***************************************** -->
	<bean id="searchEngine"
		class="com.oxia.fwk.searchengine.SearchEngine" lazy-init="true">
		<property name="searchEngineDAO">
			<ref bean="searchEngineDAO" />
		</property>
	</bean>

	<bean id="searchEngineDAO"
		class="com.oxia.fwk.searchengine.SearchEngineDAO" lazy-init="true">
		<property name="basicAction">
			<ref bean="basicActionImpl" />
		</property>
	</bean>

	<bean id="criteria" class="com.oxia.daoImpl.CriteriaImpl"
		singleton="false" />
	<bean id="expression" class="com.oxia.daoImpl.ExpressionImpl"
		lazy-init="true" />



</beans>

