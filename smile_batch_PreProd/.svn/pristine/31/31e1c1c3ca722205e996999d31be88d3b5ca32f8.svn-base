<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN"
"http://www.springframework.org/dtd/spring-beans.dtd">
<beans>
	<bean id="scheduler"
		class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="configLocation">
			<value>./config/quartz.properties</value>
		</property>
		<property name="triggers">
			<list>
				<!--ref bean="specTrigger" /-->
				<ref bean="cronTrigger" />
				<ref bean="cronTriggerLiquidation" />
			</list>
		</property>
		<!--property name="jobListeners">
			<list>
				<ref bean="mailExceptionListner" />
			</list>
		</property-->
		<property name="applicationContextSchedulerContextKey">
			<value>applicationContext</value>
		</property>
		<!--property name="schedulerListeners">
			<list>
				<ref bean="schedulerListner" />
			</list>
		</property-->
		<property name="calendars">
			<map>
				<entry key="annualCalendar">
					<ref bean="annualCalendar" />
				</entry>
			</map>
		</property>
	</bean>

	<bean id="abstractJob"
		class="com.oxia.scheduling.quartz.core.JobDetailBean"
		abstract="true">
		<property name="jobClass"
			value="com.oxia.scheduling.quartz.core.AbstractJob" />
		<!--property name="jobListenerNames">
			<list>
				<value>OXIA_JOB_LISTNER</value>
			</list>
		</property-->
	</bean>
	
	
	 <bean id="abstractFileJob"
		class="com.oxia.scheduling.quartz.core.JobDetailBean"
		abstract="true">
		<property name="jobClass"
			value="com.oxia.scheduling.quartz.jobs.file.AbstractFileJob" />
		<property name="jobListenerNames">
			<list>
				<value>OXIA_JOB_LISTNER</value>
			</list>
		</property>
	</bean>

	<!--bean id="dataSource"
		class="org.apache.commons.dbcp.BasicDataSource">
		<property name="driverClassName" value="org.postgresql.Driver" />
		<property name="url" value="jdbc:postgresql://localhost/quartz" />
		<property name="username" value="postgres" />
		<property name="password" value="postgres" />
		<property name="removeAbandoned" value="true"/>
		<property name="removeAbandonedTimeout" value="50"/>
	</bean-->

</beans>