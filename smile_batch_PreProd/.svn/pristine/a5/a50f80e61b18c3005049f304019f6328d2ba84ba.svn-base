import java.util.ArrayList;
import java.util.List;

import com.bna.commun.model.Categorie;
import com.oxia.fwk.core.ValueObject;

/** Fichier: ListTypeCatTpce.java version 1.0.0 du 07/03/2007
 * Copyright(c) 2006 BNA (www.bna.com.tn)
 * Classe: ListRgmCatEpargne
 * package: com.bna.smile.model.souscriptionContratCompte.model
 * Auteur : Boussen Youssef & Kriaa Hatem
 */
public class ListRgmCatEpargne extends ValueObject {

    private List listRgmEpargne = new ArrayList();
    private List listCatEpargne = new ArrayList();
    private Categorie categorie;


    public ListRgmCatEpargne() {
    }

    public void setListRgmEpargne(List listRgmEpargne) {
        this.listRgmEpargne = listRgmEpargne;
    }

    public List getListRgmEpargne() {
        return listRgmEpargne;
    }

    public void setListCatEpargne(List listCatEpargne) {
        this.listCatEpargne = listCatEpargne;
    }

    public List getListCatEpargne() {
        return listCatEpargne;
    }

    public void setCategorie(Categorie categorie) {
        this.categorie = categorie;
    }

    public Categorie getCategorie() {
        return categorie;
    }
}
